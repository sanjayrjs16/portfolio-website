---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
---
<div id="game-container">
	<!-- Screens will be dynamically inserted here -->
</div>



<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

#game-container {
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
    color: white;
}

.screen {
    width: 100%;
    height: 100%;
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
}

.button {
    padding: 15px 30px;
    margin: 10px;
    border: none;
    border-radius: 5px;
    background: #4CAF50;
    color: white;
    cursor: pointer;
    font-size: 1.2em;
}

.button:hover {
    background: #45a049;
}
.game-screen {
    text-align: center;
    padding: 20px;
}

.game-info {
    margin-bottom: 20px;
}

.score-info {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin: 15px 0;
}

.game-controls {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    max-width: 500px;
    margin: 0 auto;
}

.number-button {
    padding: 15px;
    font-size: 1.2em;
}

.game-status {
    margin-top: 20px;
    font-size: 1.2em;
    min-height: 60px;
}

.result-screen {
    text-align: center;
}

.result-screen h2 {
    margin-bottom: 20px;
}

.result-screen p {
    margin: 10px 0;
}

.result-screen h3 {
    margin: 20px 0;
    font-size: 1.5em;
}
</style>
