---
interface WorkItem {
    type: 'featured' | 'project';
    title: string;
    description: string;
    image?: string;
    link?: string;
    github?: string;
    techStack?: string[];
    launchedBy?: string;
}

interface Props {
    currentSection: keyof typeof sectionContent;
}

const { currentSection } = Astro.props;

// Placeholder content for each section
const sectionContent = {
    'notable-work': [
        {
            type: 'featured',
            title: 'Aadujeevitham: The Goat Life',
            description: 'Official movie website',
            image: 'https://thegoatlifefilm.com/_astro/every_breath_desktop.r_dlPKcE_Z16Fwf7.webp',
            link: '/works/goatlife',
            launchedBy: 'A R Rahman'
        },
        {
            type: 'project',
            title: 'OHC Network Chatbot',
            description: 'Open-source COVID assistance bot aiding Kerala Government healthcare (2020)',
            github: 'https://github.com/ohcnetwork/bot',
            techStack: ['Node.js', 'Express', 'MongoDB', 'NLP'],
            link: 'https://www.youtube.com/watch?v=A81YflXaZKQ'
        }
    ],
    'personal-projects': [] as WorkItem[],
    'professional': [] as WorkItem[],
    'videos': [] as WorkItem[]
} as const;
---

<div class="works-content">
    {sectionContent[currentSection]?.map(item => (
        item.type === 'featured' ? (
            <a href={item.link} class="featured-card glass-card">
                <div class="card-image">
                    <img src={item.image} alt={item.title} />
                </div>
                <div class="card-content">
                    <h2 class="title-text">{item.title}</h2>
                    <p class="description-text">
                        {item.description}
                        {item.launchedBy && 
                            <span>
                                Launched by <span class="highlight-text">{item.launchedBy}</span>
                            </span>
                        }
                    </p>
                </div>
            </a>
        ) : (
            <div class="project-card glass-card">
                <div class="card-header">
                    <a href={item.github} class="github-icon" target="_blank" rel="noopener noreferrer">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                    </a>
                    <h2 class="title-text">{item.title}</h2>
                </div>
                <p class="description-text">{item.description}</p>
                {item.link && (
                    <a href={item.link} class="highlight-link" target="_blank" rel="noopener noreferrer">
                        Watch Demo →
                    </a>
                )}
                {item.techStack && (
                    <div class="tech-stack">
                        {item.techStack.map(tech => <span class="tech-tag">{tech}</span>)}
                    </div>
                )}
            </div>
        )
    ))}
</div>

<style>
    .works-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        padding: 1rem;
    }

    .featured-card {
        width: 280px;
        text-decoration: none;
        color: white;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .featured-card:hover {
        transform: translateY(-5px);
    }

    .card-image {
        width: 100%;
        aspect-ratio: 16/9;
        overflow: hidden;
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .featured-card:hover .card-image img {
        transform: scale(1.05);
    }

    .card-content {
        padding: 1rem;
    }

    .project-card {
        padding: 1.5rem;
        color: white;
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .github-icon {
        color: rgba(255, 255, 255, 0.7);
        transition: color 0.3s ease;
    }

    .github-icon:hover {
        color: white;
    }

    .tech-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .tech-tag {
        background: rgba(138, 43, 226, 0.2);
        color: rgba(255, 255, 255, 0.8);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-size: 0.8rem;
    }

    @media (max-width: 768px) {
        .works-content {
            grid-template-columns: 1fr;
            padding: 0.5rem;
        }
        
        .featured-card {
            width: 100%;
        }
    }
</style> 