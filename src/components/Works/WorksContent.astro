---
import FeaturedProjectCard from './FeaturedProjectCard.astro';
import StackProjectCard from './StackProjectCard.astro';
import LetTheDevsCookCard from './LetTheDevsCookCard.astro';
import SupabaseRecognitionCard from './SupabaseRecognitionCard.astro';
import type { FeaturedProject, StackProject } from './workProjectTypes';

const featuredRow1: FeaturedProject[] = [
    {
        slug: 'goat-life',
        title: 'The Goat Life Official Website',
        role: 'Web Engineer',
        summary:
            'Built the official movie promotional website for The Goat Life, launched by A. R. Rahman, director Blessy, and author Benyamin as part of the film’s rollout.',
        metrics: ['Official film site'],
        stack: ['Astro', 'TypeScript', 'Decap CMS', 'Framer Motion'],
        image: '/goat.webp',
        tone: 'cinematic' as const,
        caseStudyPath: '/works/goat-life',
        caseStudyCta: 'View case study',
        links: [{ label: 'Live site', url: 'https://thegoatlifefilm.com' }]
    },
    {
        slug: 'sunroad',
        title: 'Sun Road Co.',
        role: 'Lead Fullstack Product Engineer · Founding Team',
        summary:
            'Sun Road Co. is a search platform for locals to find creatives and for creatives to showcase their work.\n\nSolo 0→1 product.',
        metrics: ['480 users · Q1 post-launch'],
        stack: ['Next.js', 'Supabase', 'PostgreSQL', 'Stripe', 'Edge Functions'],
        image: '/sunroad-building-art.png',
        caseStudyPath: '/works/sunroad',
        caseStudyCta: 'View case study',
        mediaVariant: 'sunroad-warm',
        links: [{ label: 'Live product', url: 'https://sunroad.co' }]
    }
];

const featuredOhc: FeaturedProject = {
    slug: 'ohc-network',
    title: 'OHC Network Chatbot',
    role: 'Contributor · open source',
    summary:
        'COVID-19 guidance chatbot on Messenger and Telegram — supporting public health communication during the Kerala response.',
    metrics: ['Open source'],
    stack: ['Python', 'Rasa', 'Docker', 'GitHub Actions', 'Heroku'],
    image: '/OHC_network_logo.png',
    mediaVariant: 'logo-contain',
    caseStudyPath: '/works/ohc-network',
    caseStudyCta: 'View case study',
    links: [
        { label: 'GitHub', url: 'https://github.com/ohcnetwork/bot' },
        { label: 'Watch demo', url: 'https://www.youtube.com/watch?v=A81YflXaZKQ' }
    ]
};

const picturamaProject = {
    slug: 'picturama',
    title: 'Picturama DeFi',
    summary:
        'Web3 concept for audience-backed indie film financing — Chainlink hackathon build with IPFS and on-chain flows.',
    stack: ['Next.js', 'Solidity', 'IPFS', 'Chainlink', 'Filecoin'],
    links: [
        { label: 'GitHub', url: 'https://github.com/picturama-defi' },
        { label: 'Devpost', url: 'https://devpost.com/software/picturama-defi-financing-independent-cinema' },
        { label: 'Demo', url: 'https://www.youtube.com/watch?v=mnrl5tAp7eE&t=160s' }
    ],
    badge: 'Hackathon',
    image: '/picturama_defi_logo.png',
    caseStudyPath: '/works/picturama'
} satisfies StackProject;
---

<div class="work-bento">
    <div class="work-bento__row work-bento__row--featured">
        {featuredRow1.map((project) => <FeaturedProjectCard project={project} />)}
    </div>
    <div class="work-bento__row work-bento__row--split">
        <div class="work-bento__col work-bento__col--primary">
            <FeaturedProjectCard project={featuredOhc} />
            <LetTheDevsCookCard />
        </div>
        <div class="work-bento__col work-bento__col--stack">
            <StackProjectCard project={picturamaProject} />
            <SupabaseRecognitionCard />
        </div>
    </div>
</div>

<style>
    .work-bento {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .work-bento__row--featured {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem;
        min-width: 0;
    }

    .work-bento__row--split {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 0.9rem;
        align-items: start;
        min-width: 0;
    }

    .work-bento__col--primary {
        min-width: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .work-bento__col--primary > :global(.featured-card),
    .work-bento__col--primary > :global(.yt-channel-card) {
        width: 100%;
    }

    .work-bento__col--stack {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        min-width: 0;
        width: 100%;
    }

    .work-bento__col--stack > :global(.stack-card),
    .work-bento__col--stack > :global(.sb-card) {
        width: 100%;
    }

    @media (max-width: 960px) {
        .work-bento__row--featured,
        .work-bento__row--split {
            grid-template-columns: 1fr;
        }

        .work-bento__col--stack {
            gap: 0.75rem;
        }
    }
</style>
