---
import StarryLayout from '../layouts/StarryLayout.astro';
import YouTubeVideos from '../components/Posts/YouTubeVideos';
import '../components/Posts/YouTubeVideos.css';

const blogPosts = [
    {
        title: "Cashing In on Caching as a Frontend Engineer",
        link: "https://medium.com/better-programming/cashing-in-on-caching-as-a-frontend-engineer-611a7c57f6b5",
        platform: "Medium"
    },
    {
        title: "Is Proof of Stake (PoS) a game changer & what it means for blockchains & web3?",
        link: "https://dev.to/sanjayrjs16/the-gist-of-proof-of-stake-pos-39h2",
        platform: "Dev.to"
    },
    {
        title: "Build a custom Solana faucet",
        link: "https://sanjayrajesh.hashnode.dev/custom-solana-faucet-using-nextjs-part-1",
        platform: "Hashnode"
    }
];

const title = 'Posts | Sanjay Rajesh';
const description = 'Blogs and videos by Sanjay Rajesh on frontend engineering, product development, performance, and real-world software lessons.';
---

<StarryLayout title={title} description={description}>
    <div class="posts-container">
        <section class="posts-card" aria-labelledby="blog-posts-heading">
            <div class="posts-card__head">
                <h2 id="blog-posts-heading">Blogs</h2>
                <p>Write-ups and engineering notes across platforms.</p>
            </div>
            <ul class="posts-list">
                {blogPosts.map((post, index) => (
                    <li class="post-item" style={`--index: ${index}`}>
                        <a
                            href={post.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="post-link"
                        >
                            <span class="post-title-wrap">
                                <span class="post-number">{index + 1}.</span>
                                <span class="post-title">{post.title}</span>
                            </span>
                            <span class="platform">{post.platform}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </section>
        
        <YouTubeVideos client:load />
    </div>
</StarryLayout>

<style>
    .posts-container {
        --posts-card-width: 880px;
        width: min(920px, 100%);
        padding: 2rem;
        margin: 6rem auto 2rem;
        min-height: calc(100dvh - 8rem);
        color: white;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        align-items: center;
        justify-content: center;
    }

    h1 {
        font-size: 2rem;
        margin-bottom: 2rem;
        font-family: 'Space Grotesk', sans-serif;
    }

    .posts-card {
        width: min(var(--posts-card-width), 100%);
        box-sizing: border-box;
        margin-inline: auto;
        padding: 1.1rem 1.15rem;
        border-radius: 16px;
        background: linear-gradient(165deg, rgba(252, 250, 246, 0.94) 0%, rgba(238, 234, 228, 0.9) 100%);
        border: 1px solid rgba(200, 188, 170, 0.45);
        backdrop-filter: blur(18px) saturate(1.15);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.08),
            0 4px 24px rgba(20, 12, 40, 0.12),
            inset 0 1px 0 rgba(255, 255, 255, 0.65);
        font-family: 'Space Grotesk', sans-serif;
    }

    .posts-card__head {
        display: grid;
        gap: 0.2rem;
        margin-bottom: 0.55rem;
    }

    .posts-card__head h2 {
        margin: 0;
        color: #1c1917;
        font-size: clamp(1rem, 2.2vw, 1.2rem);
        letter-spacing: -0.02em;
    }

    .posts-card__head p {
        margin: 0;
        color: rgba(55, 48, 40, 0.72);
        font-size: 0.82rem;
        line-height: 1.4;
    }

    .posts-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.42rem;
        width: 100%;
    }

    .post-item {
        opacity: 0;
        animation: fadeIn 0.45s ease-out forwards;
        animation-delay: calc(var(--index) * 0.08s);
    }

    .post-link {
        color: #1c1917;
        text-decoration: none;
        padding: 0.7rem 0.8rem;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.55);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.6rem;
        transition: all 0.3s ease;
        border: 1px solid rgba(200, 188, 170, 0.32);
        font-family: 'Space Grotesk', sans-serif;
    }

    .post-link:hover,
    .post-link:focus-visible {
        background: rgba(255, 255, 255, 0.8);
        transform: translateY(-2px);
        border-color: rgba(168, 85, 247, 0.28);
        outline: none;
    }

    .post-title {
        font-size: 0.92rem;
        color: rgba(28, 25, 23, 0.92);
        line-height: 1.45;
    }

    .post-title-wrap {
        display: inline-flex;
        align-items: flex-start;
        gap: 0.5rem;
        min-width: 0;
    }

    .post-number {
        font-size: 0.76rem;
        color: rgba(76, 29, 149, 0.85);
        font-weight: 700;
        line-height: 1.5;
        min-width: 1.15rem;
    }

    .platform {
        font-size: 0.68rem;
        color: rgba(76, 29, 149, 0.9);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border: 1px solid rgba(126, 58, 237, 0.22);
        background: rgba(139, 92, 246, 0.08);
        border-radius: 999px;
        padding: 0.2rem 0.5rem;
        white-space: nowrap;
        font-family: 'Space Grotesk', sans-serif;
    }

    /* Dark mode inversion (light mode stays unchanged) */
    :global(html[data-theme='dark'] .posts-card) {
        background: linear-gradient(165deg, rgba(30, 30, 38, 0.86) 0%, rgba(20, 20, 26, 0.82) 100%);
        border: 1px solid rgba(168, 85, 247, 0.28);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.12),
            0 10px 34px rgba(0, 0, 0, 0.35),
            inset 0 1px 0 rgba(255, 255, 255, 0.06),
            inset 0 -1px 0 rgba(255, 255, 255, 0.04);
    }

    :global(html[data-theme='dark'] .posts-card__head h2) {
        color: rgba(255, 255, 255, 0.96) !important;
    }

    :global(html[data-theme='dark'] .posts-card__head p) {
        color: rgba(255, 255, 255, 0.72) !important;
    }

    :global(html[data-theme='dark'] .post-link) {
        color: rgba(255, 255, 255, 0.92);
        background: rgba(30, 30, 38, 0.70);
        border: 1px solid rgba(200, 188, 170, 0.18);
    }

    :global(html[data-theme='dark'] .post-link:hover),
    :global(html[data-theme='dark'] .post-link:focus-visible) {
        background: rgba(40, 40, 50, 0.86);
        border-color: rgba(168, 85, 247, 0.35);
    }

    :global(html[data-theme='dark'] .post-title) {
        color: rgba(255, 255, 255, 0.96);
    }

    :global(html[data-theme='dark'] .post-number) {
        color: rgba(225, 190, 255, 0.92);
    }

    :global(html[data-theme='dark'] .platform) {
        color: rgba(225, 190, 255, 0.98);
        border-color: rgba(168, 85, 247, 0.25);
        background: rgba(139, 92, 246, 0.10);
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 768px) {
        .posts-container {
            margin: 5rem auto 1rem;
            padding: 1rem;
            width: calc(100% - 2rem);
            min-height: calc(100dvh - 6rem);
        }

        .posts-card {
            padding: 0.95rem 0.9rem;
        }

        .post-link {
            align-items: flex-start;
            flex-direction: column;
            position: relative;
            padding: 0.85rem 0.75rem 0.58rem;
        }

        .post-title-wrap {
            padding-right: 4.1rem;
        }

        .platform {
            position: absolute;
            top: 0.42rem;
            right: 0.45rem;
            font-size: 0.58rem;
            padding: 0.14rem 0.4rem;
            letter-spacing: 0.03em;
        }
    }
</style> 