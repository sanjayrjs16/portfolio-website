---
import LaserBeamSketch from '../components/LaserBeam/LaserBeamSketch';
// import FolderStructure from '../components/FolderStructure/FolderStructure';
import Layout from '../layouts/Layout.astro';
// import PortalBlob from '../components/PortalBlob.astro';
// import Welcome from '../components/Welcome.astro';
// import PerlinEyeSketch from '../components/Eye/PerlinEyeSketch';
// import GenerativeEyeSketch from '../components/Eye/GenerativeEyeSketch';
// import OrganicGrowth from '../components/OrganicGrowth.astro';
// import RealisticTrees from '../components/RealisticTrees.astro';
import SocialIcons from '../components/SocialIcons/SocialIcons';
import BackgroundFallback from '../components/BackgroundFallback.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.

// Get current path
const currentPath = Astro.url.pathname;

// SEO metadata
const title = "Sanjay Rajesh - Web Developer";
const description = "Frontend focused web engineer building performant, scalable, accessible, and secure web apps with an immersive digital experiences through code & creativity.";
---

<Layout title={title} description={description}>
	<BackgroundFallback />
	<main>
		<!-- SEO-friendly fallback content -->
		<noscript>
			<div class="fallback-hero">
				<img 
					src="/images/hero-fallback.jpg" 
					alt="Space-themed background with Sanjay Rajesh's portfolio" 
					class="fallback-bg"
				/>
				<div class="fallback-content">
					<h1>SANJAY RAJESH</h1>
					<p>Frontend focused web engineer building performant, scalable, accessible, and secure web apps with an immersive digital experiences through code & creativity.</p>
				</div>
			</div>
		</noscript>

		<!-- Main content -->
		<section class="hero-section">
			<LaserBeamSketch client:only="react" />
			<div class="hero-content">
				<div class="hero-content-right">
					<div class="bio-container">
						<p class="fun-text">Hey, I build stuff on the web for a living :)</p>
						<p class="fun-text">Cooking up performant, secure and scalable web apps with an immersive user experience & creative interactions. <span class="highlight-text "> 🔄 Refresh to see the sky change</span></p>
						

						

						<div class="quote-accordion">
							<label for="quote-toggle" class="tap-label">
								<span class="quote-label-text hide-desktop">Tap here 👉</span>
							</label>
							<input type="checkbox" id="quote-toggle" class="accordion-checkbox">
							<label for="quote-toggle" class="accordion-trigger">
								<span class="arrow">▼</span>
							</label>
							<div class="quote-content">
								<div class="bg-purple">
									<p class="fun-text" style="border-bottom: 1px solid #8a2be2; margin-bottom: 1rem; text-transform: uppercase;">👨🏻‍💻 Major works ( More <a href="/works/" class="link">here</a>)</p>
									
									<!-- Special styling for the movie item -->
									<div class="movie-text ">
										
										<span class="description">
											🎬
										Aadujeevitham: The Goat Life (2024), official movie <a href="https://thegoatlifefilm.com/" target="_blank" rel="noopener noreferrer" class="link">
											Website
										</a> launched by 
											<a href="https://timesofindia.indiatimes.com/entertainment/malayalam/movies/news/director-blessy-on-aadujeevitham-website-launch/articleshow/108015198.cms" target="_blank" rel="noopener noreferrer" class="link">A R Rahman✨</a> 
										</span>
									</div>
							
									<!-- GitHub item with grid styling -->
									<div class="github-text link-container">
										<span class="icon">
											<a href="https://github.com/ohcnetwork/bot" target="_blank" rel="noopener noreferrer" class="link">
												<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
													<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
												</svg>
											</a>
										</span>
										<a href="https://github.com/ohcnetwork/bot" target="_blank" rel="noopener noreferrer" class="link">
											OHC Network Chatbot
										</a>
										<span class="description"> Open-source COVID assistance bot for OHC Network aiding Kerala Government healthcare (2020) <a href="https://www.youtube.com/watch?v=A81YflXaZKQ" target="_blank" rel="noopener noreferrer" class="link">demo</a></span>
									</div>
									<!-- YouTube item with grid styling -->
									<div class="youtube-text link-container">
										<span class="icon" style="transform: translate(0, 0.2rem)">
											<a href="https://www.youtube.com/@letthedevscook" target="_blank" rel="noopener noreferrer" class="link">
												<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
													<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" fill="currentColor"/>
												</svg>
											</a>
										</span>
										<a href="https://www.youtube.com/@letthedevscook" target="_blank" rel="noopener noreferrer" class="link">
											Let the devs cook
										</a>
										<!-- <span class="icon">👈</span> -->
										<span class="description"> YouTube channel</span>
									</div>
								</div>
								
								<p class="quote-text yellow-border">Reach me at <span class="highlight-text "> sanjayrajesh.exe@gmail.com</span></p>
								<p class="quote-text">"The Art challenges the technology & the technology inspires the art"</p>
								<!-- <p class="quote-text ">"</p> -->
								<p class="attribution-text">- John Lasseter</p>
						
							</div>
						</div>

						<div class="seo-content" aria-hidden="true">
							<h2>Frontend Engineer & Creative Developer</h2>
							<p>
								Hi, I'm Sanjay Rajesh, a frontend engineer specializing in creating immersive digital experiences. 
								With expertise in JavaScript, TypeScript,React, node.js, and creative coding, I blend technology with artistry to craft 
								engaging web applications and interactive experiences.
							</p>
							<p>
								My work focuses on performance-optimized, accessible web development with a strong emphasis on 
								user experience and creative interactions. Experienced in modern frontend frameworks, WebGL, 
								and generative art.
							</p>
						</div>
					</div>
				</div>
				<div class="hero-content-left">
					<h1 class="hero-title">
						<span class="title-line" data-text="SANJAY">SANJAY</span>
						<span class="title-line" data-text="RAJESH">RAJESH</span>
					</h1>
					<div class="social-icons">
						<SocialIcons client:load />
					</div>
				</div>
			</div>
		</section>

		<!-- Content Sections -->
		<!-- <section class="content-section">
			<SpaceBackground client:only="react">
				<div class="portfolio-section">
					<FolderStructure client:only="react" onSelect={() => console.log('path')} />
				</div>
			</SpaceBackground>
		</section> -->
	</main>
	<!-- <GenerativeEyeSketch client:only="react"/>
	<PerlinEyeSketch client:only="react"/>
	<OrganicGrowth />
	<RealisticTrees /> -->
	<!-- <script  src="../scripts/main.js"></script> -->
</Layout>

<style>

	main {
		width: 100%;
	}

.sm{
	font-size: clamp(0.5rem, 4vw, 1.5rem) !important;
}
	.hero-section {
		height: 100dvh;
		width: 100%;
		position: relative;
		overflow: hidden;
	}

	.hero-content {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none; /* This allows clicks to pass through to the canvas */
	}

	.hero-content-left {
		position: absolute;
		top: 70%;
		left: 75%;
		transform: translate(-65%, -75%);
		text-align: center;
		z-index: 10;
		pointer-events: auto; /* Enable pointer events for social icons */
	}

	.hero-content-right {
		position: absolute;
		top: 10%;
		left: 2%;
		transform: translateX(-2%, -10%);
		z-index: 20; /* Increased z-index to be higher than hero-content-left */
		max-width: 38vw;
		text-align: left;
	}

	.hero-title {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		/* background: linear-gradient(45deg, #070707c5 30%, #0a0013); */
		opacity: 0;
		animation: fadeIn 1s ease-out 2s forwards;
		position: relative;
		z-index: 5;
	}

	.title-line {
		position: relative;
		font-family: 'Audiowide', sans-serif;
		font-size: clamp(3rem, 8vw, 5.5rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
		transform: skew(-5deg);
		display: block;
		
		background-image: linear-gradient(
			-225deg,
			#c17ce9 0%,
			#fff9fe 29%,
			#e35bf1 67%,
			#c17ce9 100%
		);
		background-size: 200% auto;
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		animation: textclip 5s linear infinite;
	}

	/* Remove or adjust these pseudo-elements if they're covering the animation */
	.title-line::before {
		content: attr(data-text);
		position: absolute;
		left: 0;
		top: 0;
		z-index: -1;  /* Move it behind */
		background: linear-gradient(45deg, #c17ce9 30%, #fff9fe);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-shadow: 0 0 20px rgba(227, 219, 227, 0.124),
					 0 0 40px rgba(226, 91, 241, 0.483);
	}

	.title-line::after {
		content: attr(data-text);
		position: absolute;
		left: 0;
		top: 0;
		z-index: -1;  /* Move it behind */
		background: linear-gradient(90deg, transparent, #f8eafb, transparent);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: shine 3s infinite;
	}

	@keyframes textclip {
		0% { background-position: 0 50%; }
		50% { background-position: 100% 50%; }
		100% { background-position: 0% 50%; }
	}

	@keyframes shine {
		0% {
		
			transform: translateX(0%);
		}
		25% {
		
			transform: translateX(0.5%);
		}
		50% {
			transform: translateX(0%);
		}
		75% {
			transform: translateX(-0.5%);
			
		}
		100% {
			transform: translateX(0%);
		}
	}

	.hero-subtitle {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(1.2rem, 2vw, 1.8rem);
		color: rgba(255, 255, 255, 0.9);
		line-height: 1.4;
		font-weight: 300;
		margin: 0;
		animation: float 3s ease-in-out infinite;
	}

	.highlight {
		display: block;
		font-weight: 500;
		color: #8a2be2;
		font-size: 1.1em;
		text-shadow: 0 0 10px rgba(138, 43, 226, 0.5);
	}

	.content-section {
		width: 100%;
		min-height: 100vh;
	}

	.portfolio-section {
		min-height: 100vh;
		padding: 2rem;
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(10px);
	}

	/* Folder structure styles */
	:global(.folder-structure) {
		color: white;
		font-family: 'Inter', monospace;
		padding: 1rem;
		max-width: 800px;
		margin: 0 auto;
	}

	:global(.folder-item) {
		margin: 0.5rem 0;
	}

	:global(.folder-header) {
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem;
		border-radius: 4px;
		transition: all 0.2s ease;
	}

	:global(.folder-header:hover) {
		background: rgba(255, 255, 255, 0.1);
	}

	:global(.folder-children) {
		margin-left: 1.5rem;
		border-left: 1px solid rgba(255, 255, 255, 0.2);
		padding-left: 0.5rem;
	}

	:global(.folder-name) {
		font-size: 1.1rem;
		font-weight: 500;
	}

	:global(.folder-icon), :global(.file-icon) {
		font-size: 1.2rem;
	}

	@media (max-width: 768px) {
		.hero-content-left {
			top: 70%;
		left: 60%;
		transform: translate(-60%, -60%);
		}

		.hero-content-right {
			top: 9%;
			left: 50%;
        transform: translate(-50%, -7%);
			/* bottom: 18.5%; */
			max-width: 98vw;
		}
	}

	:global(.social-icons) {
		position: absolute;
		left: 2%;
		transform: translateX(-2%);
		display: flex;
		gap: 0.25rem;
		z-index: 10;
		margin-top: 0.88rem;
		width: fit-content;
		min-width: 65vw;
		opacity: 0;
		
	}

	:global(.social-icon) {
		width: 2.8rem;  /* Slightly smaller */
		height: 2.8rem;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(5px);
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
		transition: all 0.3s ease;
		opacity: 0;
		animation: fadeIn 0.5s ease-out forwards, iconFloat 4s ease-in-out infinite, glowPulse 2s infinite alternate;
		animation-delay: calc(var(--delay, 0s) + 1.5s), calc(var(--delay, 0s) + 1s);
		text-shadow: 0 0 8px var(--yellow-color);
 
	}
	@keyframes glowPulse {
  0% {
    box-shadow: 0 0 8px 2px #ffe066, 0 0 16px 4px #ffe06644;
    filter: drop-shadow(0 0 8px #ffe066);
  }
  50% {
    box-shadow: 0 0 24px 8px #ffe066, 0 0 48px 16px #ffe06644;
    filter: drop-shadow(0 0 24px #ffe066);
  }
  100% {
    box-shadow: 0 0 8px 2px #ffe066, 0 0 16px 4px #ffe06644;
    filter: drop-shadow(0 0 8px #ffe066);
  }
}
	:global(.social-icon:hover) {
		background:  rgba(255, 255, 255, 0.4);
		transform: translateY(-5px);
		box-shadow: 0 0 8px 2px var(--yellow-color), 0 0 8x 2px #ffe06688;
  filter: drop-shadow(0 0 8px #ffe066);

	}

	:global(.social-icon svg) {
		width: 1.4rem;  /* Slightly smaller icons */
		height: 1.4rem;
		color: var(--white-color);
		text-shadow: 0 0 8px var(--yellow-color);
	}

	@media (max-width: 768px) {
		:global(.social-icons) {
			gap: 1rem;
		}

		:global(.social-icon) {
			width: 2.2rem;
			height: 2.2rem;
			backdrop-filter: blur(10px);
		}

		:global(.social-icon svg) {
			width: 1.1rem;
			height: 1.1rem;
		}
	}

	.fallback-hero {
		display: none;
	}

	/* Show fallback only when JS is disabled */
	noscript .fallback-hero {
		display: block;
		position: relative;
		height: 100vh;
		width: 100%;
	}

	.fallback-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.fallback-content {
		position: relative;
		z-index: 2;
		padding: 2rem;
		color: white;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		background: rgba(0, 0, 0, 0.5);
	}

	.bio-container {
		pointer-events: auto; /* This enables pointer events back for the bio */
		background: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(10px);
		padding: 1rem;
		border-radius: 8px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		opacity: 0;
		animation: fadeIn 1s ease-out 2s forwards;
		position: relative;
		z-index: 20; /* Increased z-index to be higher than hero-content-left */
	}

	.quote-text {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(0.7rem, 1vw, 1.2rem);
		color: rgba(255, 255, 255, 0.9);
		margin: 0;
		text-wrap: wrap;
		padding-top: 1rem;
	}
	/* #bfd518; */
	.bg-purple {
		background-color: rgba(79, 78, 79, 0.359);
		padding: 0.2rem;
		border-radius: 0.5rem;
		margin: 0.2rem 0;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}


	.attribution-text {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(0.8rem, 1.5vw, 1.2rem);
		color: rgba(255, 255, 255, 0.7);
		margin: 0.5rem 0;
		font-style: italic;
	}

	.fun-text {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(0.8rem, 1.5vw, 1rem);
		color: rgba(255, 255, 255, 0.8);
		margin: 1rem 0 0 0;
	}

	.quote-accordion {
		margin-top: 1rem;
		position: relative;
	}

	.accordion-checkbox {
		display: none;
	}
	.hide-desktop {
		display: none;
	}
	.accordion-trigger {
		position: absolute;
		top: -15px;
		right: 0;
		color: rgba(255, 255, 255, 0.6);
		cursor: pointer;
		padding: 0.25rem;
		display: none;
		transform: rotate(90deg);
	}

	.arrow {
		display: inline-block;
		transition: transform 0.3s ease;
	}

	.accordion-checkbox:checked + .accordion-trigger .arrow {
		transform: rotate(-90deg);
	}
	.quote-label-text {
		position: absolute;
		top: -15px;
		right: 5%;
		color: rgba(255, 255, 255, 0.6);
		cursor: pointer;
		padding: 0.25rem;
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(0.8rem, 1.25vw, 1.4rem);
	}

	@media (max-width: 768px) {
		.hide-desktop {
		display: inline;
	}
		.accordion-trigger {
			display: block;
		}

		.quote-content {
			/* margin-top: 1rem; */
			max-height: 500px;
			opacity: 1;
			transition: all 0.3s ease;
		}

		.accordion-checkbox:not(:checked) ~ .quote-content {
			max-height: 0;
			opacity: 0;
			overflow: hidden;
		}
	}

	.seo-content {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.link-container {
		display: grid;
		grid-template-columns: 10% 30% 60%; /* Proportional columns as requested */
		align-items: center;
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(0.6vw, 1vw, 1.2vw);
		color: rgba(255, 255, 255, 0.8);
		margin: 0.55rem 0;
	}

	.icon {
		font-size: 1.2em;
		animation: pulse 2s ease-in-out infinite;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.link {
		color: var(--purple-color);
		text-decoration: none;
		position: relative;
		font-weight: 500;
		transition: all 0.3s ease;
		white-space: nowrap;
		border-bottom: 1px solid var(--yellow-color); 
		margin-right: 0.35rem;
		font-size: clamp(0.8vw, 1vw, 1.5vw);
	}

	.link:hover {
		color: var(--yellow-color);
		text-shadow: 0 0 8px var(--yellow-color);
		border-bottom: none;
	}

	.link::after {
		content: '';
		position: absolute;
		width: 100%;
		height: 1px;
		bottom: -2px;
		left: 0;
		background: var(--purple-color);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.3s ease;
	}

	.link:hover::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.description {
		color: rgba(255, 255, 255, 0.8);
		font-size: clamp(0.75vw, 1vw, 1.2rem);
		/* white-space: nowrap; */
	}
	.yellow-border {
		border-bottom: 1px solid var(--yellow-color) ;
		border-top: 1px solid var(--yellow-color);
		border-radius: 0.5rem;
		padding: 0.2rem;
		text-align: center;
		margin-top: 0.5rem;
		
	}

	/* Make tap-label clickable and style it properly */
	.tap-label {
		cursor: pointer;
		display: inline-block;
	}

	/* Add fade-in animations for various elements */
	.hero-title {
		opacity: 0;
		animation: fadeIn 1s ease-out 0.2s forwards;
	}

	.social-icons {
		opacity: 0;
		animation: fadeIn 1s ease-out 1.5s forwards;
	}

	.bio-container {
		opacity: 0;
		animation: fadeIn 1s ease-out 1s forwards;
	}

	/* Define the fade-in animation */
	@keyframes fadeIn {
		from { 
			opacity: 0;
