---
const navItems = [
  { path: '/works/', label: 'Works' },
  { path: '/', label: 'Bio' },
  { path: '/posts/', label: 'Posts' },
  // { path: '/contact', label: 'Contact' }
];

const currentPath = Astro.url.pathname;
const showTitle = currentPath !== '/'; // Only show title when not on home/bio page
---

{showTitle && (
  <a href="/" class="brand-title">
    <span class="title-line" data-text="SANJAY">SANJAY</span>
    <span class="title-line" data-text="RAJESH">RAJESH</span>
  </a>
)}

<nav class="navigation">
  {navItems.map(item => (
    <a
      href={item.path}
      class={`nav-item ${currentPath === item.path ? 'active' : ''}`}
    >
      {item.label}
    </a>
  ))}
</nav>

<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
  <span class="theme-toggle__label" aria-hidden="true">Light</span>
</button>

<script>
  // @ts-nocheck
  const THEME_KEY = 'theme';
  const root = document.documentElement;
  const toggleBtn = document.getElementById('theme-toggle');
  const labelEl = toggleBtn?.querySelector('.theme-toggle__label');

  /**
   * @param {'light'|'dark'} theme
   */
  function applyTheme(theme) {
    root.dataset.theme = theme;
    if (labelEl) labelEl.textContent = theme === 'dark' ? 'Dark' : 'Light';
  }

  const saved = typeof window !== 'undefined' ? window.localStorage.getItem(THEME_KEY) : null;
  const initial = saved === 'dark' || saved === 'light' ? saved : 'light';
  applyTheme(initial);

  toggleBtn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    window.localStorage.setItem(THEME_KEY, next);
    applyTheme(next);
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syncopate:wght@700&display=swap');

  .theme-toggle {
    position: fixed;
    top: 1.7rem;
    right: 1.15rem;
    z-index: 250;
    appearance: none;
    border: 1px solid rgba(200, 188, 170, 0.45);
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(14px);
    border-radius: 999px;
    padding: 0.4rem 0.65rem;
    color: rgba(28, 25, 23, 0.86);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    box-shadow:
      0 0 0 1px rgba(168, 85, 247, 0.06),
      0 6px 22px rgba(20, 12, 40, 0.10);
    opacity: 0;
    animation: navFadeIn 1s ease-out forwards;
  }

  .theme-toggle:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.78);
    border-color: rgba(168, 85, 247, 0.25);
  }

  .navigation {
    position: fixed;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 100;
    background: linear-gradient(165deg, rgba(252, 250, 246, 0.94) 0%, rgba(238, 234, 228, 0.9) 100%);
    border: 1px solid rgba(200, 188, 170, 0.45);
    box-shadow:
      0 0 0 1px rgba(168, 85, 247, 0.08),
      0 4px 24px rgba(20, 12, 40, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.65);
    padding: 0.38rem 0.42rem;
    border-radius: 14px;
    backdrop-filter: blur(14px);
  }

  .nav-item {
    color: rgba(28, 25, 23, 0.86);
    text-decoration: none;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(0.78rem, 0.9vw, 0.92rem);
    font-weight: 600;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    padding: 0.32rem 0.78rem;
    border-radius: 999px;
    transition: all 0.3s ease;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(200, 188, 170, 0.32);
    backdrop-filter: blur(5px);
    white-space: nowrap;
    animation: navFadeIn 1s ease-out forwards;
  }

  .nav-item:hover {
    color: rgba(28, 25, 23, 0.95);
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(168, 85, 247, 0.3);
    transform: translateY(-2px);
  }

  .nav-item.active {
    background: rgba(139, 92, 246, 0.14);
    color: rgba(76, 29, 149, 0.95);
    border-color: rgba(126, 58, 237, 0.34);
  }

  :global(html[data-theme='dark'] .navigation) {
    background: linear-gradient(165deg, rgba(30, 30, 38, 0.8) 0%, rgba(20, 20, 26, 0.78) 100%);
    border-color: rgba(168, 85, 247, 0.25);
  }

  :global(html[data-theme='dark'] .nav-item) {
    background: rgba(30, 30, 38, 0.75);
    border-color: rgba(200, 188, 170, 0.18);
    color: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(10px);
  }

  :global(html[data-theme='dark'] .nav-item:hover) {
    color: rgba(255, 255, 255, 0.95);
    background: rgba(40, 40, 50, 0.86);
    border-color: rgba(168, 85, 247, 0.35);
  }

  :global(html[data-theme='dark'] .nav-item.active) {
    background: rgba(139, 92, 246, 0.18);
    color: rgba(237, 211, 255, 0.96);
    border-color: rgba(168, 85, 247, 0.35);
  }

  :global(html[data-theme='dark'] .theme-toggle) {
    background: rgba(30, 30, 38, 0.78);
    border-color: rgba(168, 85, 247, 0.25);
    color: rgba(255, 255, 255, 0.86);
  }

  .brand-title {
    position: fixed;
    top: 2rem;
    left: 2rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    z-index: 100;
    line-height: 0.9;
    opacity: 0;
    animation: navFadeIn 1s ease-out forwards;
    z-index: 200;
    padding: 0.2rem;
    background: rgba(8, 8, 12, 0.7);
    backdrop-filter: blur(3.5px);
    border-radius: 6px;
  }

  .title-line {
    font-family: 'Audiowide', sans-serif;
    font-size: clamp(1rem, 1.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    transform: skew(-5deg);
    background-image: linear-gradient(
      -225deg,
      #c17ce9 0%,
      #fff9fe 29%,
      #e35bf1 67%,
      #c17ce9 100%
    );
    background-size: 200% auto;
    color: #fff;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: textclip 3s linear infinite;
  }

  @keyframes textclip {
    to {
      background-position: 200% center;
    }
  }

  @keyframes navFadeIn {
  from { 
    opacity: 0;
    transform: translateY(-10px); 
  }
  to { 
    opacity: 1;
    transform: translateY(0);
  }
}


  @media (max-width: 768px) {
    .navigation {
      top: 0.45rem;
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      justify-content: center;
      gap: 0.38rem;
      width: max-content;
      max-width: calc(100vw - 1rem);
      margin: 0 auto;
      border-radius: 12px;
      padding: 0.62rem 0.5rem;
      backdrop-filter: blur(8px);
    }

    .nav-item {
      padding: 0.3rem 0.64rem;
      font-size: 0.62rem;
    }

    .brand-title {
      top: 0.95rem;
      left: 0.9rem;
    }

    .title-line {
      font-size: 0.7rem;
    }

    .theme-toggle {
      top: 0.8rem;
      right: 0.65rem;
      padding: 0.32rem 0.55rem;
      font-size: 0.64rem;
    }
  }
</style> 