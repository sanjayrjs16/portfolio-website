---
interface WorkItem {
    type: 'featured' | 'project';
    title: string;
    description: string;
    image?: string;
    link?: string;
    github?: string;
    techStack?: string[];
    launchedBy?: string;
    awards?: string[];
    size?: 'large' | 'medium' | 'small';
}

interface Props {
    currentSection: keyof typeof sectionContent;
}

const { currentSection } = Astro.props;

// Placeholder content for each section
const sectionContent: Record<string, WorkItem[]> = {
    'notable-work': [
        {
            type: 'featured',
            title: 'Aadujeevitham: The Goat Life',
            description: 'Official movie website',
            image: 'https://thegoatlifefilm.com/_astro/every_breath_desktop.r_dlPKcE_Z16Fwf7.webp',
            link: '/works/goatlife',
            launchedBy: 'A R Rahman',
            size: 'large'
        },
        {
            type: 'project',
            title: 'OHC Network COVID-19 Chatbot (2020)',
            description: 'Build a COVID-19 info chatbot for OHC Network that provided real-time updates & guidance aiding the efforts of Government of Kerala during the pandemic, operating on platforms like Facebook Messenger and Telegram.',
            github: 'https://github.com/ohcnetwork/bot',
            image: 'https://ohc.network/ohc_logo_white.svg',
            techStack: ['Python', 'Rasa framework', 'Docker', 'Github Actions', 'Heroku'],
            link: 'https://www.youtube.com/watch?v=A81YflXaZKQ',
            size: 'medium'
        },
        {
            type: 'project',
            title: 'Picturama-DeFi',
            description: 'Decentralized film funding platform built for Chainlink Fall 2021 Hackathon. Enables direct audience participation in independent cinema financing using smart contracts and IPFS. Recognized with a Filecoin prize for its use of decentralized storage.',
            github: 'https://github.com/picturama-defi',
            image: 'https://sanjayrjs.vercel.app/picturama.png',
            techStack: ['Next.js', 'Express.js', 'Solidity', 'IPFS', 'Ethers.js', 'Web3.js', 'Chainlink', 'Filecoin'],
            link: 'https://www.youtube.com/watch?v=mnrl5tAp7eE&t=160s',
            awards: ['Chainlink Fall 2021 Hackathon – Filecoin Prize Winner'],
            size: 'small'
        }
    ],
    'personal-projects': [],
    'professional': [],
    'videos': []
} as const;
---

<div class="works-content">
    <div class="left-column">
        {sectionContent[currentSection]?.filter(item => item.type === 'featured' || item.size === 'medium').map(item => (
            <div class={item.size}>
                {item.type === 'featured' ? (
                    <a href={item.link} class="featured-card glass-card">
                        <div class="card-image">
                            <img src={item.image} alt={item.title} />
                        </div>
                        <div class="card-content">
                            <h2 class="title-text">{item.title}</h2>
                            {/* <p class="description-text">
                                {item.description}
                                {item.launchedBy && 
                                    <span>
                                        Launched by <span class="highlight-text">{item.launchedBy}</span>
                                    </span>
                                }
                            </p> */}
                        </div>
                    </a>
                ) : (
                    <div class="project-card glass-card">
                        {item.image && (
                            <div class="project-image">
                                <img src={item.image} alt={item.title} />
                            </div>
                        )}
                        <div class="card-content-wrapper">
                            <div class="card-header">
                                <h2 class="title-text">{item.title}</h2>
                            </div>
                            <p class="description-text">{item.description}</p>
                            {item.awards && (
                                <div class="awards">
                                    {item.awards.map(award => (
                                        <span class="award-tag">🏆 {award}</span>
                                    ))}
                                </div>
                            )}
                            <div class="card-links">
                                <a href={item.github} class="highlight-link" target="_blank" rel="noopener noreferrer">
                                    <svg class="github-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                    </svg>
                                    View Source
                                </a>
                                {item.link && (
                                    <a href={item.link} class="highlight-link" target="_blank" rel="noopener noreferrer">
                                        Watch Demo →
                                    </a>
                                )}
                            </div>
                            {item.techStack && (
                                <div class="tech-stack">
                                    {item.techStack.map(tech => <span class="tech-tag">{tech}</span>)}
                                </div>
                            )}
                        </div>
                    </div>
                )}
            </div>
        ))}
    </div>
    
    <div class="right-column">
        {sectionContent[currentSection]?.filter(item => item.size === 'small').map(item => (
            <div class="small">
                <div class="project-card glass-card">
                    {item.image && (
                        <div class="project-image">
                            <img src={item.image} alt={item.title} />
                        </div>
                    )}
                    <div class="card-content-wrapper">
                        <div class="card-header">
                            <h2 class="title-text">{item.title}</h2>
                        </div>
                        <p class="description-text">{item.description}</p>
                        {item.awards && (
                            <div class="awards">
                                {item.awards.map(award => (
                                    <span class="award-tag">🏆 {award}</span>
                                ))}
                            </div>
                        )}
                        <div class="card-links">
                            <a href={item.github} class="highlight-link" target="_blank" rel="noopener noreferrer">
                                <svg class="github-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                                View Source
                            </a>
                            {item.link && (
                                <a href={item.link} class="highlight-link" target="_blank" rel="noopener noreferrer">
                                    Watch Demo →
                                </a>
                            )}
                        </div>
                        {item.techStack && (
                            <div class="tech-stack">
                                {item.techStack.map(tech => <span class="tech-tag">{tech}</span>)}
                            </div>
                        )}
                    </div>
                </div>
            </div>
        ))}
    </div>
</div>

<style>
    .works-content {
        display: grid;
        grid-template-columns: 1fr 1fr; /* Two equal columns */
        gap: 1rem;
        padding: 1.5rem;
        height: calc(100vh - 100px);
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Left column */
    .left-column {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* Right column */
    .right-column {
        height: 100%;
    }

    .large {
        height: 35%;
    }

    .medium {
        height: 18%;
    }

    .small {
        height: 100%;
    }

    .card-image, .project-image {
        height: 65%; /* Reduce image height */
        aspect-ratio: auto;
    }

    .project-image {
        height: 120px; /* Fixed height for project images */
        padding: 1rem;
    }

    .project-image img {
        max-height: 100%;
        width: auto;
        object-fit: contain;
    }

    .featured-card, .project-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 
            0 4px 30px rgba(0, 0, 0, 0.1),
            inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    }

    .featured-card {
        width: 180px;
        text-decoration: none;
        color: white;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .featured-card:hover, .project-card:hover {
        background: rgba(255, 255, 255, 0.08);
        transform: translateY(-5px);
        box-shadow: 
            0 8px 40px rgba(0, 0, 0, 0.2),
            inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .featured-card:hover .card-image img {
        transform: scale(1.05);
    }

    .card-content {
        padding: 0.2rem;
    }

    .project-card {
        padding: 1.5rem;
        color: white;
    }

    .card-header {
        margin-bottom: 1rem;
    }

    .card-header .title-text {
        font-size: clamp(1rem, 1.5vw, 1.3rem);
        margin: 0;
    }

    .card-links {
        display: flex;
        gap: 1rem;
        margin: 1rem 0;
    }

    .card-links .highlight-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .github-icon {
        opacity: 0.8;
        transition: opacity 0.3s ease;
    }

    .highlight-link:hover .github-icon {
        opacity: 1;
    }

    .tech-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .tech-tag {
        background: rgba(138, 43, 226, 0.1);
        color: rgba(255, 255, 255, 0.9);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-size: 0.8rem;
        border: 1px solid rgba(138, 43, 226, 0.2);
    }

    .awards {
        margin: 1rem 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .award-tag {
        background: rgba(255, 215, 0, 0.1);
        color: rgba(255, 215, 0, 0.9);
        padding: 0.3rem 0.8rem;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        border: 1px solid rgba(255, 215, 0, 0.2);
    }

    /* Add opensource badge */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(46, 204, 113, 0.1);
        color: rgba(46, 204, 113, 0.9);
        padding: 0.3rem 0.8rem;
        border-radius: 4px;
        font-size: 0.85rem;
        border: 1px solid rgba(46, 204, 113, 0.2);
        margin-bottom: 1rem;
    }

    /* Update responsive breakpoints */
    @media (max-width: 1024px) {
        .works-content {
            grid-template-rows: 50% 45%;
        }
    }

    @media (max-width: 768px) {
        .works-content {
            grid-template-columns: 1fr;
            height: auto;
            gap: 1rem;
        }
        
        .left-column {
            gap: 1rem;
        }

        .large, .medium, .small {
            height: auto;
        }

        /* Keep Picturama layout consistent on mobile */
        .small .project-card {
            grid-template-columns: auto 1fr;
        }
    }

    /* Picturama card layout */
    .small .project-card {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1.5rem;
        align-items: start;
        padding: 1.5rem;
    }

    .small .project-image {
        height: 80px;
        width: 80px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .small .project-image img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .small .card-content-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
</style> 