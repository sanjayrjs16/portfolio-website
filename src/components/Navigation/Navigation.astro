---
const navItems = [
  { path: '/works/', label: 'Works' },
  { path: '/', label: 'Bio' },
  { path: '/posts/', label: 'Content' },
  // { path: '/contact', label: 'Contact' }
];

const currentPath = Astro.url.pathname;

/** Match case study subpaths (e.g. /works/sunroad) to Works */
function isNavActive(pathname: string, itemPath: string) {
  if (itemPath === '/') return pathname === '/' || pathname === '';
  const base = itemPath.replace(/\/$/, '');
  return pathname === base || pathname.startsWith(`${base}/`);
}

const showTitle = currentPath !== '/'; // Only show title when not on home/bio page
---

{showTitle && (
  <a href="/" class="brand-title">
    <span class="title-line" data-text="SANJAY">SANJAY</span>
    <span class="title-line" data-text="RAJESH">RAJESH</span>
  </a>
)}

<div class="site-chrome" transition:persist="site-chrome">
  <nav class="navigation">
    {navItems.map((item) => (
      <a
        href={item.path}
        class:list={['nav-item', { active: isNavActive(currentPath, item.path) }]}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode">
    <span class="theme-toggle__track" aria-hidden="true">
      <span class="theme-toggle__icon theme-toggle__icon--sun">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 1.8v3.1M12 19.1v3.1M4.85 4.85l2.2 2.2M16.95 16.95l2.2 2.2M1.8 12h3.1M19.1 12h3.1M4.85 19.15l2.2-2.2M16.95 7.05l2.2-2.2" />
        </svg>
      </span>
      <span class="theme-toggle__icon theme-toggle__icon--moon">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M14.2 2.5a8.9 8.9 0 1 0 7.3 13.9 9.7 9.7 0 0 1-7.7-9.4c0-1.6.4-3.1 1.1-4.5a10.2 10.2 0 0 1-.7 0Z" />
        </svg>
      </span>
      <span class="theme-toggle__thumb"></span>
    </span>
  </button>
</div>

<script>
  // @ts-nocheck
  const THEME_KEY = 'theme';
  const root = document.documentElement;
  const toggleBtn = document.getElementById('theme-toggle');
  /**
   * @param {'light'|'dark'} theme
   */
  function applyTheme(theme) {
    root.dataset.theme = theme;
    toggleBtn?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  }

  const saved = typeof window !== 'undefined' ? window.localStorage.getItem(THEME_KEY) : null;
  const initial = saved === 'dark' || saved === 'light' ? saved : 'light';
  applyTheme(initial);

  toggleBtn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    window.localStorage.setItem(THEME_KEY, next);
    applyTheme(next);
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syncopate:wght@700&display=swap');

  /* Grouping for transition:persist only; fixed children still anchor to viewport */
  .site-chrome {
    position: static;
  }

  .theme-toggle {
    position: fixed;
    top: 1.7rem;
    right: 1.15rem;
    z-index: 250;
    appearance: none;
    border: 1px solid rgba(200, 188, 170, 0.45);
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(14px);
    border-radius: 999px;
    padding: 0.2rem;
    color: rgba(28, 25, 23, 0.86);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow:
      0 0 0 1px rgba(168, 85, 247, 0.06),
      0 6px 22px rgba(20, 12, 40, 0.10);
    opacity: 1;
  }

  /* App routes + nav links on bio: chrome stays visible, no entrance animation */
  :global(html[data-route='app']) .navigation,
  :global(html[data-route='app']) .theme-toggle,
  :global(html[data-route='bio']) .navigation {
    opacity: 1;
    animation: none;
  }

  /* Bio home only: theme toggle matches .bio-container — delayed fade */
  :global(html[data-route='bio']) .theme-toggle {
    opacity: 0;
    animation: bioChromeFade 1s ease-out 2.7s forwards;
  }

  /* Opacity-only so mobile nav keep translateX(-50%) for centering */
  @keyframes bioChromeFade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .theme-toggle:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.78);
    border-color: rgba(168, 85, 247, 0.25);
  }

  .theme-toggle__track {
    --toggle-w: 3.15rem;
    --toggle-h: 1.58rem;
    --thumb-size: 1.22rem;
    --thumb-inset: 0.16rem;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    width: var(--toggle-w);
    height: var(--toggle-h);
    border-radius: 999px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.7), rgba(233, 228, 220, 0.64));
    border: 1px solid rgba(190, 178, 160, 0.4);
    overflow: hidden;
  }

  .theme-toggle__icon {
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    line-height: 0;
  }

  .theme-toggle__icon svg {
    width: 0.82rem;
    height: 0.82rem;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: color 0.25s ease, opacity 0.25s ease;
  }

  .theme-toggle__icon--sun svg {
    color: rgba(202, 138, 4, 0.95);
  }

  .theme-toggle__icon--moon svg {
    color: rgba(76, 29, 149, 0.78);
    fill: rgba(76, 29, 149, 0.78);
    stroke: none;
  }

  .theme-toggle__thumb {
    position: absolute;
    top: calc((var(--toggle-h) - var(--thumb-size)) / 2);
    left: var(--thumb-inset);
    width: var(--thumb-size);
    height: var(--thumb-size);
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #fff7d6 0%, #facc15 58%, #d97706 100%);
    box-shadow:
      0 0 0 1px rgba(202, 138, 4, 0.24),
      0 6px 14px rgba(20, 12, 40, 0.2);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), background 0.28s ease, box-shadow 0.28s ease;
  }

  .navigation {
    position: fixed;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 100;
    background: linear-gradient(165deg, rgba(252, 250, 246, 0.94) 0%, rgba(238, 234, 228, 0.9) 100%);
    border: 1px solid rgba(200, 188, 170, 0.45);
    box-shadow:
      0 0 0 1px rgba(168, 85, 247, 0.08),
      0 4px 24px rgba(20, 12, 40, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.65);
    padding: 0.38rem 0.42rem;
    border-radius: 14px;
    backdrop-filter: blur(14px);
  }

  .nav-item {
    color: rgba(28, 25, 23, 0.86);
    text-decoration: none;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(0.78rem, 0.9vw, 0.92rem);
    font-weight: 600;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    padding: 0.32rem 0.78rem;
    border-radius: 999px;
    transition:
      background 0.28s ease,
      border-color 0.28s ease,
      color 0.28s ease,
      box-shadow 0.28s ease,
      transform 0.2s ease;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(200, 188, 170, 0.32);
    backdrop-filter: blur(5px);
    white-space: nowrap;
  }

  .nav-item:hover {
    color: rgba(28, 25, 23, 0.92);
    background: rgba(255, 255, 255, 0.68);
    border-color: rgba(168, 85, 247, 0.22);
    transform: translateY(-1px);
  }

  .nav-item.active {
    background: rgba(139, 92, 246, 0.14);
    color: rgba(76, 29, 149, 0.95);
    border-color: rgba(126, 58, 237, 0.34);
    box-shadow: 0 0 0 1px rgba(126, 58, 237, 0.12);
  }

  :global(html[data-theme='dark'] .navigation) {
    background: linear-gradient(165deg, rgba(30, 30, 38, 0.8) 0%, rgba(20, 20, 26, 0.78) 100%);
    border-color: rgba(168, 85, 247, 0.25);
  }

  :global(html[data-theme='dark'] .nav-item) {
    background: rgba(30, 30, 38, 0.75);
    border-color: rgba(200, 188, 170, 0.18);
    color: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(10px);
    box-shadow: none;
  }

  :global(html[data-theme='dark'] .nav-item:hover) {
    color: rgba(255, 255, 255, 0.9);
    background: rgba(38, 38, 48, 0.82);
    border-color: rgba(168, 85, 247, 0.28);
    transform: translateY(-1px);
  }

  :global(html[data-theme='dark'] .nav-item.active) {
    background: rgba(139, 92, 246, 0.18);
    color: rgba(237, 211, 255, 0.96);
    border-color: rgba(168, 85, 247, 0.35);
    box-shadow: 0 0 0 1px rgba(168, 85, 247, 0.12);
  }

  :global(html[data-theme='dark'] .theme-toggle) {
    background: rgba(30, 30, 38, 0.78);
    border-color: rgba(168, 85, 247, 0.25);
    color: rgba(255, 255, 255, 0.86);
  }

  :global(html[data-theme='dark'] .theme-toggle__track) {
    background: linear-gradient(160deg, rgba(16, 16, 24, 0.82), rgba(32, 30, 42, 0.8));
    border-color: rgba(168, 85, 247, 0.22);
  }

  :global(html[data-theme='dark'] .theme-toggle__icon--sun svg) {
    color: rgba(245, 208, 94, 0.58);
    opacity: 0.6;
  }

  :global(html[data-theme='dark'] .theme-toggle__icon--moon svg) {
    color: rgba(226, 232, 255, 0.96);
    fill: rgba(226, 232, 255, 0.96);
    opacity: 1;
  }

  :global(html[data-theme='dark'] .theme-toggle__thumb) {
    transform: translateX(calc(var(--toggle-w) - var(--thumb-size) - (var(--thumb-inset) * 2)));
    background: radial-gradient(circle at 35% 30%, #eef2ff 0%, #c4b5fd 60%, #7c3aed 100%);
    box-shadow:
      0 0 0 1px rgba(168, 85, 247, 0.35),
      0 6px 16px rgba(0, 0, 0, 0.35);
  }

  .brand-title {
    position: fixed;
    top: 2rem;
    left: 2rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    z-index: 100;
    line-height: 0.9;
    opacity: 1;
    z-index: 200;
    padding: 0.2rem;
    background: rgba(8, 8, 12, 0.7);
    backdrop-filter: blur(3.5px);
    border-radius: 6px;
  }

  .title-line {
    font-family: 'Audiowide', sans-serif;
    font-size: clamp(1rem, 1.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    transform: skew(-5deg);
    background-image: linear-gradient(
      -225deg,
      #c17ce9 0%,
      #fff9fe 29%,
      #e35bf1 67%,
      #c17ce9 100%
    );
    background-size: 200% auto;
    color: #fff;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: textclip 3s linear infinite;
  }

  @keyframes textclip {
    to {
      background-position: 200% center;
    }
  }

  @media (max-width: 768px) {
    .navigation {
      top: 0.45rem;
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      justify-content: center;
      gap: 0.38rem;
      width: max-content;
      max-width: calc(100vw - 1rem);
      margin: 0 auto;
      border-radius: 12px;
      padding: 0.62rem 0.5rem;
      backdrop-filter: blur(8px);
    }

    .nav-item {
      padding: 0.3rem 0.64rem;
      font-size: 0.62rem;
    }

    .brand-title {
      top: 0.95rem;
      left: 0.9rem;
    }

    .title-line {
      font-size: 0.7rem;
    }

    .theme-toggle {
      top: 0.8rem;
      right: 0.65rem;
      padding: 0.18rem;
    }

    .theme-toggle__track {
      --toggle-w: 2.85rem;
      --toggle-h: 1.42rem;
      --thumb-size: 1.06rem;
    }

    .theme-toggle__thumb {
      width: var(--thumb-size);
      height: var(--thumb-size);
    }
  }
</style> 