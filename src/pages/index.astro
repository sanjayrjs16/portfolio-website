---
import LaserBeamSketch from '../components/LaserBeam/LaserBeamSketch';
// import FolderStructure from '../components/FolderStructure/FolderStructure';
import Layout from '../layouts/Layout.astro';
// import PortalBlob from '../components/PortalBlob.astro';
// import Welcome from '../components/Welcome.astro';
// import PerlinEyeSketch from '../components/Eye/PerlinEyeSketch';
// import GenerativeEyeSketch from '../components/Eye/GenerativeEyeSketch';
// import OrganicGrowth from '../components/OrganicGrowth.astro';
// import RealisticTrees from '../components/RealisticTrees.astro';
import SocialIcons from '../components/SocialIcons/SocialIcons';
import BackgroundFallback from '../components/BackgroundFallback.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.

// Get current path
const currentPath = Astro.url.pathname;

// SEO metadata
const title = "Sanjay Rajesh - Web Developer";
const description = "Frontend focused web engineer building performant, scalable, accessible, and secure web apps with an immersive digital experiences through code & creativity.";
---

<Layout title={title} description={description}>
	<BackgroundFallback />
	<main>
		<!-- SEO-friendly fallback content -->
		<noscript>
			<div class="fallback-hero">
				<img 
					src="/images/hero-fallback.jpg" 
					alt="Space-themed background with Sanjay Rajesh's portfolio" 
					class="fallback-bg"
				/>
				<div class="fallback-content">
					<h1>SANJAY RAJESH</h1>
					<p>Frontend focused web engineer building performant, scalable, accessible, and secure web apps with an immersive digital experiences through code & creativity.</p>
				</div>
			</div>
		</noscript>

		<!-- Main content -->
		<section class="hero-section">
			<LaserBeamSketch client:only="react" />
			<div class="hero-content">
				<div class="hero-content-right">
					<div class="bio-container">
						<div class="bio-block">
							<p class="fun-text bio-intro">
								Hola, I'm Sanjay 👋<br/> 
								<span>I build stuff on the web for a living :) <br/>Currently building <a href="https://www.sunroad.io" target="_blank" rel="noopener noreferrer" class="link">Sun Road Co.</a></span>
See all of <a href="/works/" rel="noopener noreferrer" class="link">my works.</a> <br/>
YouTube Channel: <a href="https://www.youtube.com/@letthedevscook/featured" target="_blank" rel="noopener noreferrer" class="link">Let The Devs Cook.</a> 
							</p>
							
							<p class="quote-text">"The Art challenges the technology & the technology inspires the art"</p>
							<p class="attribution-text">- John Lasseter</p>
						
							<p class="bio-credit">* <a href="https://www.instagram.com/p/CBL86c5DbZV/" target="_blank" rel="noopener noreferrer" class="link">site based on art i made</a></p>
						</div>
					</div>
				</div>
				<div class="hero-content-left">
					
						<h1 class="hero-title hero-title-box">
							<span class="title-line" data-text="SANJAY">SANJAY</span>
							<span class="title-line" data-text="RAJESH">RAJESH</span>
						</h1>
					
					<div class="social-icons">
						<SocialIcons client:load />
					</div>
				</div>
			</div>
		</section>

		<!-- Content Sections -->
		<!-- <section class="content-section">
			<SpaceBackground client:only="react">
				<div class="portfolio-section">
					<FolderStructure client:only="react" onSelect={() => console.log('path')} />
				</div>
			</SpaceBackground>
		</section> -->
	</main>
	<!-- <GenerativeEyeSketch client:only="react"/>
	<PerlinEyeSketch client:only="react"/>
	<OrganicGrowth />
	<RealisticTrees /> -->
	<!-- <script  src="../scripts/main.js"></script> -->
</Layout>

<style>

	main {
		width: 100%;
	}

.sm{
	font-size: clamp(0.5rem, 4vw, 1.5rem) !important;
}
	.hero-section {
		height: 100dvh;
		width: 100%;
		position: relative;
		overflow: hidden;
	}

	.hero-content {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none; /* This allows clicks to pass through to the canvas */
	}

	.hero-content-left {
		position: absolute;
		top: 70%;
		left: 75%;
		transform: translate(-65%, -75%);
		text-align: center;
		z-index: 10;
		pointer-events: auto; /* Enable pointer events for social icons */
	}

	.hero-content-right {
		position: absolute;
		top: 10%;
		left: 2%;
		transform: translate(-2%, -10%);
		z-index: 20; /* Increased z-index to be higher than hero-content-left */
		max-width: 38vw;
		text-align: left;
	}

	.hero-title-box {
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(10px);
		padding: 1rem 1.25rem;
		border-radius: 8px;
		border-bottom: 1px solid var(--yellow-color);
		border-top: 1px solid var(--yellow-color);
		box-shadow: 0 0 12px rgba(193, 124, 233, 0.25);
		display: inline-block;
	}

	.hero-title {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		/* background: linear-gradient(45deg, #070707c5 30%, #0a0013); */
		opacity: 0;
		animation: fadeIn 1s ease-out 2s forwards;
		position: relative;
		z-index: 5;
	}

	.title-line {
		position: relative;
		font-family: 'Audiowide', sans-serif;
		font-size: clamp(3rem, 8vw, 5.5rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
		transform: skew(-5deg);
		display: block;
		
		background-image: linear-gradient(
			-225deg,
			#c17ce9 0%,
			#fff9fe 29%,
			#e35bf1 67%,
			#c17ce9 100%
		);
		background-size: 200% auto;
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		animation: textclip 5s linear infinite;
	}

	/* Remove or adjust these pseudo-elements if they're covering the animation */
	.title-line::before {
		content: attr(data-text);
		position: absolute;
		left: 0;
		top: 0;
		z-index: -1;  /* Move it behind */
		background: linear-gradient(45deg, #c17ce9 30%, #fff9fe);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-shadow: 0 0 20px rgba(227, 219, 227, 0.124),
					 0 0 40px rgba(226, 91, 241, 0.483);
	}

	.title-line::after {
		content: attr(data-text);
		position: absolute;
		left: 0;
		top: 0;
		z-index: -1;  /* Move it behind */
		background: linear-gradient(90deg, transparent, #f8eafb, transparent);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: shine 3s infinite;
	}

	@keyframes textclip {
		0% { background-position: 0 50%; }
		50% { background-position: 100% 50%; }
		100% { background-position: 0% 50%; }
	}

	@keyframes shine {
		0% {
		
			transform: translateX(0%);
		}
		25% {
		
			transform: translateX(0.5%);
		}
		50% {
			transform: translateX(0%);
		}
		75% {
			transform: translateX(-0.5%);
			
		}
		100% {
			transform: translateX(0%);
		}
	}

	.hero-subtitle {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(1.2rem, 2vw, 1.8rem);
		color: rgba(255, 255, 255, 0.9);
		line-height: 1.4;
		font-weight: 300;
		margin: 0;
		animation: float 3s ease-in-out infinite;
	}

	.highlight {
		display: block;
		font-weight: 500;
		color: #8a2be2;
		font-size: 1.1em;
		text-shadow: 0 0 10px rgba(138, 43, 226, 0.5);
	}

	.content-section {
		width: 100%;
		min-height: 100vh;
	}

	.portfolio-section {
		min-height: 100vh;
		padding: 2rem;
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(10px);
	}

	/* Folder structure styles */
	:global(.folder-structure) {
		color: white;
		font-family: 'Inter', monospace;
		padding: 1rem;
		max-width: 800px;
		margin: 0 auto;
	}

	:global(.folder-item) {
		margin: 0.5rem 0;
	}

	:global(.folder-header) {
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem;
		border-radius: 4px;
		transition: all 0.2s ease;
	}

	:global(.folder-header:hover) {
		background: rgba(255, 255, 255, 0.1);
	}

	:global(.folder-children) {
		margin-left: 1.5rem;
		border-left: 1px solid rgba(255, 255, 255, 0.2);
		padding-left: 0.5rem;
	}

	:global(.folder-name) {
		font-size: 1.1rem;
		font-weight: 500;
	}

	:global(.folder-icon), :global(.file-icon) {
		font-size: 1.2rem;
	}

	@media (max-width: 768px) {
		.hero-content-left {
			top: 70%;
		left: 60%;
		transform: translate(-60%, -60%);
		}

		.hero-content-right {
			top: 9%;
			left: 50%;
        transform: translate(-50%, -7%);
			/* bottom: 18.5%; */
			max-width: 98vw;
		}
	}

	:global(.social-icons) {
		position: absolute;
		left: 2%;
		transform: translateX(-2%);
		display: flex;
		gap: 0.25rem;
		z-index: 10;
		margin-top: 0.88rem;
		width: fit-content;
		min-width: 65vw;
		opacity: 0;
		
	}

	:global(.social-icon) {
		width: 2.8rem;  /* Slightly smaller */
		height: 2.8rem;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(5px);
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
		transition: all 0.3s ease;
		opacity: 0;
		animation: fadeIn 0.5s ease-out forwards, iconFloat 4s ease-in-out infinite, glowPulse 2s steps(40) infinite alternate;
		animation-delay: calc(var(--delay, 3s) + 2.5s), calc(var(--delay, 4s) + 3s);
		text-shadow: 1px 2px 15px var(--yellow-color);
 
	}
	@keyframes glowPulse {
  0% {
    box-shadow: 0 0 1px 1px #f0e9ca9b, 0 0 6px 2px #ffe06611;
    filter: drop-shadow(0 0 2px #ffffff94);
  }
  /* 50% {
    box-shadow: 0 0 4px 2px #fff4c844, 0 0 8px 4px #fffcef22;
    filter: drop-shadow(0 0 4px #c2c1bb55);
  } */
  100% {
    box-shadow: 0 0 2px 1px #ffe06622, 0 0 6px 2px #ffe06611;
    filter: drop-shadow(0 0 2px #f4f3f133);
  }
}

	:global(.social-icon:hover) {
		background:  rgba(100, 105, 4, 0.8);
		transform: translateY(-5px);
		box-shadow: 0 0 8px 2px var(--yellow-color), 0 0 8x 2px #ffe06688;
  filter: drop-shadow(0 0 8px #ffe066);

	}

	:global(.social-icon svg) {
		width: 1.4rem;  /* Slightly smaller icons */
		height: 1.4rem;
		color: var(--white-color);
		text-shadow: 0 0 8px var(--yellow-color);
	}

	@media (max-width: 768px) {
		:global(.social-icons) {
			gap: 1rem;
		}

		:global(.social-icon) {
			width: 2.2rem;
			height: 2.2rem;
			backdrop-filter: blur(10px);
		}

		:global(.social-icon svg) {
			width: 1.1rem;
			height: 1.1rem;
		}
	}

	.fallback-hero {
		display: none;
	}

	/* Show fallback only when JS is disabled */
	noscript .fallback-hero {
		display: block;
		position: relative;
		height: 100vh;
		width: 100%;
	}

	.fallback-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.fallback-content {
		position: relative;
		z-index: 2;
		padding: 2rem;
		color: white;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		background: rgba(0, 0, 0, 0.5);
	}

	.bio-container {
		pointer-events: auto; /* This enables pointer events back for the bio */
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(10px);
		padding: 1rem;
		border-radius: 8px;	border-bottom: 1px solid var(--yellow-color);
		border-top: 1px solid var(--yellow-color);
		box-shadow: 0 0 12px rgba(193, 124, 233, 0.25);
		opacity: 0;
		/* animation: fadeIn 1s ease-out 2s forwards; */
		position: relative;
		z-index: 20; /* Increased z-index to be higher than hero-content-left */
	}

	.quote-text {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(0.1rem, 1vw, 1.2rem);
		color: rgba(255, 255, 255, 0.9);
		margin: 0;
		text-wrap: wrap;
		padding-top: 1rem;
	}
	.attribution-text {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(0.8rem, 1.5vw, 1.2rem);
		color: rgba(255, 255, 255, 0.7);
		margin: 0.5rem 0;
		font-style: italic;
	}

	.fun-text {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(0.8rem, 1.5vw, 1rem);
		color: rgba(255, 255, 255, 0.8);
		margin: 1rem 0 0 0;
	}

	.bio-block {
		display: flex;
		flex-direction: column;
		text-align: left;
	}

	.bio-intro {
		margin: 0;
		line-height: 1.4;
		font-size: clamp(0.8rem, 1.5vw, 1rem);
		color: rgba(255, 255, 255, 0.8);
	}

	.bio-intro .link {
		white-space: nowrap;
	}

	.bio-block .quote-text {
		padding-top: 0.5rem;
		margin: 0;
	}

	.bio-block .attribution-text {
		margin: 0.2rem 0 0 0;
	}

	.bio-credit {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(0.6rem, 1vw, 0.75rem);
		color: rgba(255, 255, 255, 0.6);
		margin: 0.4rem 0 0 auto;
		align-self: flex-end;
	}

	.bio-credit .link {
		font-size: inherit;
	}

	/* Bio card — mobile typography and spacing only (compact) */
	@media (max-width: 768px) {
		.bio-container {
			width: 90vw;
			max-width: 90vw;
			padding: 0.75rem 0.85rem;
			border-radius: 10px;
		}

		.bio-block {
			gap: 0.15rem;
		}

		.bio-intro {
			font-size: 0.82rem;
			line-height: 1.4;
			margin: 0 0 0.1rem 0;
		}

		.bio-block .bio-intro .link,
		.bio-intro .link {
			font-size: 0.78rem;
			line-height: 1.35;
			white-space: normal;
		}

		.bio-block .quote-text {
			font-size: 0.75rem;
			line-height: 1.1;
			padding-top: 0.4rem;
			margin: 0;
		}

		.bio-block .attribution-text {
			font-size: 0.72rem;
			margin: 0.1rem 0 0 0;
			line-height: 1.3;
		}

		.bio-credit {
			font-size: 0.62rem;
			margin-top: 0.4rem;
			line-height: 1.3;
		}

		.bio-block .bio-credit .link {
			font-size: inherit;
		}
	}

	@media (max-width: 480px) {
		.bio-container {
			padding: 0.7rem 0.8rem;
		}

		.bio-intro {
			font-size: 0.78rem;
			line-height: 1.4;
		}

		.bio-block .bio-intro .link,
		.bio-intro .link {
			font-size: 0.74rem;
			white-space: normal;
		}

		.bio-block .quote-text {
			font-size: 0.62rem;
			line-height: 1;
			padding-top: 0.35rem;
		}

		.bio-block .attribution-text {
			font-size: 0.7rem;
		}

		.bio-credit {
			font-size: 0.6rem;
			margin-top: 0.35rem;
		}
	}

	.link {
		color: var(--purple-color);
		text-decoration: none;
		position: relative;
		font-weight: 500;
		transition: all 0.3s ease;
		white-space: nowrap;
		border-bottom: 1px solid var(--yellow-color); 
		margin-right: 0.35rem;
		font-size: clamp(0.8vw, 1vw, 1.5vw);
	}

	.link:hover {
		color: var(--yellow-color);
		text-shadow: 0 0 8px var(--yellow-color);
		border-bottom: none;
	}

	.link::after {
		content: '';
		position: absolute;
		width: 100%;
		height: 1px;
		bottom: -2px;
		left: 0;
		background: var(--purple-color);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.3s ease;
	}

	.link:hover::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.yellow-border {
		border-bottom: 1px solid var(--yellow-color);
		/* border-top: 1px solid var(--yellow-color); */
		border-radius: 0.5rem;
		padding: 0.5rem 0.5rem 0.4rem;
		margin: 0;
	}

	/* Add fade-in animations for various elements */
	.hero-title {
		opacity: 0;
		animation: fadeIn 1.5s ease-out 1.8s forwards;
	}

	.social-icons {
		opacity: 0;
		animation: fadeIn 1s ease-out 1s forwards;
	}

	.bio-container {
		opacity: 0;
		animation: fadeIn 1s ease-out 2.7s forwards;
	}

	/* Define the fade-in animation */
	@keyframes fadeIn {
		from { 
			opacity: 0;
			transform: translateY(10px); 
		}
		to { 
			opacity: 1;
			transform: translateY(0);
		}
	}
	/* Existing iconFloat animation will now start after the fade-in */
	@keyframes iconFloat {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-5px);
		}
	}

</style>

<svg style="position: absolute; width: 0; height: 0;">
	<defs>
		<filter id="wave">
			<feTurbulence 
				type="fractalNoise" 
				baseFrequency="0.02 0.05" 
				numOctaves="5" 
				seed="2" 
				result="noise">
				<animate 
					attributeName="baseFrequency" 
					dur="60s" 
					values="0.02 0.06;0.04 0.08;0.02 0.06" 
					repeatCount="indefinite"/>
			</feTurbulence>
			<feDisplacementMap 
				in="SourceGraphic" 
				in2="noise" 
				scale="30" 
				result="displacement"/>
			<feGaussianBlur in="displacement" stdDeviation="3"/>
		</filter>
	</defs>
</svg>

<script>
	// Add this to handle fallback visibility
	function handleCanvasMount() {
		const canvas = document.querySelector('canvas');
		const fallback = document.querySelector('.background-fallback');
		
		if (canvas && fallback) {
			// Add visible class to canvas
			canvas.classList.add('visible');
			
			// Add fade-out class to fallback
			fallback.classList.add('fade-out');
			
			// Remove fallback after transition
			fallback.addEventListener('transitionend', () => {
				fallback.remove();
			}, { once: true });
		}
	}

	// Check periodically until canvas is mounted
	const checkInterval = setInterval(() => {
		if (document.querySelector('canvas')) {
			handleCanvasMount();
			clearInterval(checkInterval);
		}
	}, 100);
</script>