---
import StarryLayout from '../../layouts/StarryLayout.astro';

interface Props {
    title: string;
    description: string;
    /** Short label after "Works / …" */
    breadcrumbCurrent: string;
}

const { title, description, breadcrumbCurrent } = Astro.props;
---

<StarryLayout title={title} description={description}>
    <article class="case-light">
        <div class="case-light__nav">
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <ol class="breadcrumb__list">
                    <li>
                        <a class="breadcrumb__link" href="/works">Works</a>
                    </li>
                    <li class="breadcrumb__sep" aria-hidden="true">></li>
                    <li>
                        <span class="breadcrumb__current" aria-current="page">{breadcrumbCurrent}</span>
                    </li>
                </ol>
            </nav>
            <a class="case-light__back" href="/works">← Back to Works</a>
        </div>
        <slot />
    </article>
</StarryLayout>

<style>
    .case-light {
        width: 100%;
        max-width: min(52rem, 100%);
        margin: 0 auto;
        padding: 5.25rem max(1rem, env(safe-area-inset-right)) 3rem max(1rem, env(safe-area-inset-left));
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        overflow-x: clip;
        font-family: 'Space Grotesk', sans-serif;
    }

    .case-light *,
    .case-light *::before,
    .case-light *::after {
        box-sizing: border-box;
    }

    .case-light__nav {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.55rem;
        min-width: 0;
        width: 100%;
        margin-bottom: 0.15rem;
        padding: 0.65rem 0.85rem;
        border-radius: 12px;
        background: rgba(8, 6, 18, 0.55);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
        position: relative;
        z-index: 1;
    }

    /* Light-panel link color; on starfield this must match breadcrumb (dark purple is invisible) */
    .case-light__back {
        color: rgba(216, 201, 254, 0.95);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.84rem;
        border-bottom: 1px solid rgba(250, 204, 21, 0.45);
        padding-bottom: 1px;
        max-width: 100%;
        overflow-wrap: anywhere;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .case-light__back:hover {
        color: rgba(250, 204, 21, 0.98);
        border-bottom-color: rgba(250, 204, 21, 0.75);
    }

    .breadcrumb {
        margin: 0;
        width: 100%;
        min-width: 0;
        align-self: flex-start;
    }

    .breadcrumb__list {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.28rem 0.42rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        line-height: 1.35;
        /* Readable on starfield */
        color: rgba(255, 255, 255, 0.45);
    }

    .breadcrumb__link {
        color: rgba(216, 201, 254, 0.92);
        text-decoration: none;
        border-bottom: 1px solid rgba(250, 204, 21, 0.35);
        padding-bottom: 1px;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .breadcrumb__link:hover {
        color: rgba(250, 204, 21, 0.95);
        border-bottom-color: rgba(250, 204, 21, 0.55);
    }

    .breadcrumb__sep {
        color: rgba(255, 255, 255, 0.32);
        user-select: none;
        font-weight: 400;
        font-size: 0.65em;
        margin-inline: 0.02rem;
    }

    .breadcrumb__current {
        color: rgba(255, 255, 255, 0.78);
        max-width: 100%;
        overflow-wrap: anywhere;
        font-weight: 500;
    }

    :global(.case-light .light-panel) {
        background: linear-gradient(165deg, rgba(252, 250, 246, 0.96) 0%, rgba(238, 234, 228, 0.92) 100%);
        border: 1px solid rgba(200, 188, 170, 0.48);
        border-radius: 16px;
        backdrop-filter: blur(18px) saturate(1.12);
        padding: 1.2rem 1.25rem;
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.07),
            0 6px 28px rgba(20, 12, 40, 0.1),
            inset 0 1px 0 rgba(255, 255, 255, 0.7);
        min-width: 0;
    }

    :global(.case-light .light-panel--accent) {
        border-color: rgba(212, 175, 55, 0.32);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.09),
            0 8px 32px rgba(20, 12, 40, 0.11),
            inset 0 1px 0 rgba(255, 255, 255, 0.75);
    }

    :global(.case-light .panel-title) {
        margin: 0;
        font-family: 'Audiowide', sans-serif;
        font-size: clamp(0.88rem, 2.2vw, 1.02rem);
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: #1c1917;
    }

    :global(.case-light .panel-text) {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.58;
        color: rgba(40, 36, 33, 0.88);
        overflow-wrap: anywhere;
    }

    :global(.case-light .work-link) {
        color: #6d28d9;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.84rem;
        border-bottom: 1px solid rgba(202, 138, 4, 0.55);
        padding-bottom: 1px;
        overflow-wrap: anywhere;
        align-self: flex-start;
    }

    :global(.case-light .work-link:hover) {
        color: #5b21b6;
        border-bottom-color: rgba(202, 138, 4, 0.85);
    }

    @media (max-width: 768px) {
        .case-light {
            padding: 5rem 0.85rem 2.5rem;
            gap: 1.05rem;
        }
    }

    @media (max-width: 480px) {
        .case-light {
            padding: 4.75rem 0.75rem 2rem;
        }

        .breadcrumb__list {
            font-size: 0.68rem;
            gap: 0.25rem 0.35rem;
        }
    }
</style>
