---
import StarryLayout from '../layouts/StarryLayout.astro';
import WorksContent from '../components/Works/WorksContent.astro';

const title = 'Works - Sanjay Rajesh';
const description =
    'Selected work, engineering impact, and professional experience of Sanjay Rajesh - frontend-focused fullstack product engineer.';

interface ExperienceItem {
    role: string;
    company: string;
    duration: string;
    paragraphs: string[];
    tech: string[];
    metric?: string;
}

interface RecognitionItem {
    title: string;
    detail: string;
    year: string;
    image?: string;
    links?: { label: string; url: string }[];
}

const experience: ExperienceItem[] = [
    {
        role: 'Lead Fullstack Product Engineer',
        company: 'Sun Road Co.',
        duration: '2025 — Present',
        paragraphs: [
            'On the founding team, I owned a solo 0→1 path from a dated cPanel-era stack to a shipped product on Next.js App Router and Supabase — migration, architecture, and launch included.',
            'I built the backbone users actually touch: geo-aware discovery, Stripe billing, secure Postgres with RLS and RPC-style access patterns, Edge Functions, transactional email, and the analytics and release habits (ISR, revalidation, SWR, rate limits) that keep the product fast and dependable in production.'
        ],
        tech: ['Next.js', 'Supabase', 'PostgreSQL', 'RLS', 'Stripe', 'Edge Functions', 'SWR', 'PostHog'],
        metric: '480 users · first quarter'
    },
    {
        role: 'Senior Software Engineer',
        company: 'Fingent Global Solutions · CBN Superbook',
        duration: '2022 — Present',
        paragraphs: [
            'I lead five engineers shipping React microfrontends inside a Drupal-backed platform that serves Superbook’s global audience.',
            'The work spans federated GraphQL, parent–child account models, quest- and game-style learning flows, Azure SignalR for realtime moments, and steady delivery through Bitbucket and CircleCI — balancing product ambition with maintainability.'
        ],
        tech: ['React', 'GraphQL', 'Drupal', 'Apollo', 'Azure SignalR', 'Bitbucket', 'CircleCI'],
        metric: '3M+ users touched'
    },
    {
        role: 'Software Engineer',
        company: 'Engati Technologies',
        duration: '2021 — 2022',
        paragraphs: [
            'I worked on Engati’s core no-code CX and chatbot platform, focusing on frontend quality and how features scale across teams.',
            'A major thread was modernizing surfaces such as Botstore with Next.js — better performance, clearer patterns, and a stronger base for everything built on top.'
        ],
        tech: ['React', 'TypeScript', 'Next.js', 'Python Flask', 'React Native', 'Jenkins']
    },
    {
        role: 'Assistant Systems Engineer',
        company: 'Tata Consultancy Services',
        duration: '2019 — 2021',
        paragraphs: [
            'I delivered enterprise self-service tooling — including a GA mapping portal for Aon — and internal workflows for large financial clients.',
            'Alongside product work, I introduced BDD-style automation and Jenkins pipelines that tightened feedback loops and helped cut recurring support load by about a quarter.'
        ],
        tech: ['Java', 'Node.js', 'React', 'Oracle', 'Cucumber', 'Jenkins'],
        metric: '~25% fewer support tickets'
    }
];

const recognition: RecognitionItem[] = [
    {
        title: 'Filecoin prize · Chainlink Hackathon',
        detail: 'Picturama DeFi — audience-backed indie film financing — recognized by Protocol Labs for strong use of decentralized storage.',
        year: '2021',
        image: '/picturama_defi_logo.png',
        links: [{ label: 'Devpost', url: 'https://devpost.com/software/picturama-defi-financing-independent-cinema' }]
    },
    {
        title: 'Let the Devs Cook',
        detail: 'YouTube channel focused on practical engineering breakdowns and builder-friendly walkthroughs.',
        year: 'Ongoing'
    }
];
---

<StarryLayout title={title} description={description}>
    <main class="works-shell">
        <nav class="works-subnav" aria-label="Works page sections">
            <ul class="works-subnav__list">
                <li>
                    <a class="works-subnav__link" href="#featured-work" data-subnav-target="featured-work">Featured Work</a>
                </li>
                <li>
                    <a class="works-subnav__link" href="#professional-journey" data-subnav-target="professional-journey">Professional Journey</a>
                </li>
            </ul>
        </nav>

        <section id="featured-work" class="works-section works-section--work works-section--first" aria-labelledby="featured-work-heading">
            <header class="section-head">
                <h2 id="featured-work-heading" class="section-title">Featured Work</h2>
                <p class="section-lead">
                    Highlights
                </p>
                <div class="section-rule" aria-hidden="true" />
            </header>
            <WorksContent />
        </section>

        <section id="professional-journey" class="works-section works-section--experience" aria-labelledby="professional-journey-heading">
            <header class="section-head">
                <h2 id="professional-journey-heading" class="section-title">Professional Journey</h2>
                <p class="section-lead">Roles in full context — scope, trade-offs, and what shipped.</p>
                <div class="section-rule section-rule--accent" aria-hidden="true" />
            </header>
            <div class="journey-list">
                {experience.map((item) => (
                    <article class="journey-card glass-surface">
                        <div class="journey-card__top">
                            <div class="journey-card__titles">
                                <h3>{item.role}</h3>
                                <p class="company">{item.company}</p>
                            </div>
                            <div class="journey-card__meta">
                                <span class="duration">{item.duration}</span>
                                {item.metric && <span class="impact-chip">{item.metric}</span>}
                            </div>
                        </div>
                        <div class="journey-card__body">
                            {item.paragraphs.map((p) => (
                                <p>{p}</p>
                            ))}
                        </div>
                        <div class="tech-row">
                            {item.tech.map((tech) => (
                                <span class="tech-tag">{tech}</span>
                            ))}
                        </div>
                    </article>
                ))}
            </div>
        </section>

        <section class="works-section works-section--recognition" aria-labelledby="recognition-heading">
            <header class="section-head">
                <h2 id="recognition-heading" class="section-title">Recognition</h2>
                <p class="section-lead">Awards, platform highlights, and community presence — compact, linked where it helps.</p>
                <div class="section-rule" aria-hidden="true" />
            </header>
            <div class="recognition-grid">
                {recognition.map((item) => (
                    <article
                        class:list={['recognition-card', 'glass-surface', { 'recognition-card--text-only': !item.image }]}
                    >
                        {item.image && (
                            <div class="recognition-card__visual">
                                <img src={item.image} alt="" width={160} height={160} loading="lazy" decoding="async" />
                            </div>
                        )}
                        <div class="recognition-card__content">
                            <span class="recognition-year">{item.year}</span>
                            <h3 class="recognition-card__title">{item.title}</h3>
                            <p class="recognition-detail">{item.detail}</p>
                            {item.links && item.links.length > 0 && (
                                <div class="recognition-links">
                                    {item.links.map((link) => (
                                        <a class="work-link" href={link.url} target="_blank" rel="noopener noreferrer">
                                            {link.label}
                                        </a>
                                    ))}
                                </div>
                            )}
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </main>
</StarryLayout>

<script>
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const subnavLinks = document.querySelectorAll('.works-subnav__link[href^="#"]');
    const sectionIds = ['featured-work', 'professional-journey'];

    function getScrollOffset() {
        return Math.min(window.innerHeight * 0.12, 120);
    }

    function updateSubnavActive() {
        const y = window.scrollY + getScrollOffset();
        let activeId = 'featured-work';
        for (const id of sectionIds) {
            const el = document.getElementById(id);
            if (el && el.offsetTop <= y) activeId = id;
        }
        subnavLinks.forEach((link) => {
            const match = link.dataset.subnavTarget === activeId;
            link.classList.toggle('works-subnav__link--active', match);
            if (match) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
        });
    }

    subnavLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
            const href = link.getAttribute('href');
            if (!href || !href.startsWith('#')) return;
            const id = href.slice(1);
            const target = document.getElementById(id);
            if (!target) return;
            e.preventDefault();
            target.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });
            history.pushState(null, '', href);
            window.setTimeout(updateSubnavActive, prefersReducedMotion ? 0 : 400);
        });
    });

    window.addEventListener('scroll', updateSubnavActive, { passive: true });
    window.addEventListener('resize', updateSubnavActive, { passive: true });
    window.addEventListener('hashchange', updateSubnavActive);
    document.addEventListener('DOMContentLoaded', updateSubnavActive);
    updateSubnavActive();
</script>

<style is:global>
    /* Ensure works subtree never expands past viewport from padding + width */
    .works-shell,
    .works-shell * {
        box-sizing: border-box;
    }
</style>

<style>
    .works-shell {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: min(1180px, 100%);
        margin: 0 auto;
        padding: 5.5rem max(1rem, env(safe-area-inset-right)) 2.75rem max(1rem, env(safe-area-inset-left));
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
        overflow-x: clip;
        font-family: 'Space Grotesk', sans-serif;
    }

    #featured-work,
    #professional-journey {
        scroll-margin-top: clamp(4.5rem, 12vh, 6rem);
    }

    .works-subnav {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        margin: 0 0 0.25rem;
        position: relative;
        z-index: 1;
    }

    .works-subnav__list {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem 0.55rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .works-subnav__link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.38rem 0.85rem;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        color: rgba(255, 252, 248, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.18);
        background: rgba(12, 10, 22, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background 0.2s ease,
            box-shadow 0.2s ease;
    }

    .works-subnav__link:hover {
        color: rgba(255, 252, 248, 0.92);
        border-color: rgba(250, 204, 21, 0.35);
        background: rgba(255, 255, 255, 0.07);
    }

    .works-subnav__link:focus-visible {
        outline: 2px solid rgba(168, 85, 247, 0.65);
        outline-offset: 2px;
    }

    .works-subnav__link--active {
        color: rgba(255, 252, 248, 0.95);
        border-color: rgba(250, 204, 21, 0.45);
        background: rgba(168, 85, 247, 0.14);
        box-shadow: 0 0 0 1px rgba(168, 85, 247, 0.12), 0 4px 20px rgba(24, 10, 40, 0.2);
    }

    .works-section {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1.15rem;
    }

    .works-section--first {
        padding-top: 0.15rem;
    }

    .works-section--work {
        padding-top: 0.35rem;
    }

    .works-section--experience {
        padding-top: 1.75rem;
        margin-top: 0.35rem;
        border-top: 1px solid rgba(250, 204, 21, 0.22);
    }

    .works-section--recognition {
        padding-top: 1.5rem;
        margin-top: 0.5rem;
        border-top: 1px solid rgba(168, 85, 247, 0.15);
    }

    /* Light frosted surfaces for readability on starfield */
    .glass-surface {
        background: linear-gradient(165deg, rgba(252, 250, 246, 0.94) 0%, rgba(238, 234, 228, 0.9) 100%);
        border: 1px solid rgba(200, 188, 170, 0.45);
        border-radius: 14px;
        backdrop-filter: blur(18px) saturate(1.15);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.08),
            0 4px 24px rgba(20, 12, 40, 0.12),
            inset 0 1px 0 rgba(255, 255, 255, 0.65);
    }

    .section-head {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
    }

    .section-title {
        margin: 0;
        color: rgba(255, 252, 248, 0.98);
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: clamp(1.15rem, 2.6vw, 1.5rem);
        letter-spacing: -0.02em;
        text-shadow: 0 0 32px rgba(168, 85, 247, 0.25);
    }

    .section-lead {
        margin: 0;
        max-width: 62ch;
        font-size: 0.88rem;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.62);
        font-weight: 400;
    }

    .section-rule {
        height: 1px;
        width: 100%;
        max-width: 12rem;
        background: linear-gradient(90deg, rgba(250, 204, 21, 0.55), rgba(168, 85, 247, 0.35), transparent);
        border-radius: 1px;
    }

    .section-rule--muted {
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.2), transparent);
        max-width: 8rem;
    }

    .section-rule--accent {
        background: linear-gradient(90deg, rgba(168, 85, 247, 0.5), rgba(250, 204, 21, 0.35), transparent);
    }

    .journey-list {
        display: grid;
        gap: 1rem;
        width: 100%;
        min-width: 0;
    }

    .journey-card {
        padding: 1.05rem 1.1rem;
        display: grid;
        gap: 0.85rem;
        font-family: 'Space Grotesk', sans-serif;
        min-width: 0;
    }

    .journey-card__top {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: space-between;
        align-items: flex-start;
        min-width: 0;
    }

    .journey-card__titles {
        min-width: 0;
        flex: 1 1 12rem;
    }

    .journey-card__titles h3 {
        margin: 0;
        color: #1c1917;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: clamp(0.98rem, 2.1vw, 1.12rem);
        line-height: 1.25;
        letter-spacing: -0.02em;
    }

    .company {
        margin: 0.3rem 0 0;
        color: rgba(55, 48, 40, 0.78);
        font-size: 0.9rem;
    }

    .journey-card__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        justify-content: flex-end;
        align-items: center;
    }

    .duration,
    .impact-chip,
    .tech-tag {
        display: inline-flex;
        padding: 0.26rem 0.56rem;
        border-radius: 999px;
        font-size: 0.66rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-family: 'Space Grotesk', sans-serif;
        max-width: 100%;
    }

    .duration {
        border: 1px solid rgba(120, 110, 95, 0.35);
        color: rgba(68, 60, 52, 0.8);
        background: rgba(255, 255, 255, 0.5);
    }

    .impact-chip {
        border: 1px solid rgba(5, 150, 105, 0.35);
        color: rgba(6, 95, 70, 0.95);
        background: rgba(16, 185, 129, 0.12);
    }

    .journey-card__body {
        display: grid;
        gap: 0.65rem;
        min-width: 0;
    }

    .journey-card__body p {
        margin: 0;
        color: rgba(40, 36, 33, 0.88);
        line-height: 1.58;
        font-size: 0.9rem;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .tech-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        width: 100%;
        min-width: 0;
    }

    .tech-tag {
        border: 1px solid rgba(126, 58, 237, 0.22);
        color: rgba(76, 29, 149, 0.9);
        background: rgba(139, 92, 246, 0.08);
    }

    .recognition-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        width: 100%;
        min-width: 0;
    }

    .recognition-card {
        display: grid;
        grid-template-columns: minmax(0, auto) minmax(0, 1fr);
        gap: 0.85rem;
        align-items: start;
        padding: 0.95rem 1rem;
        min-width: 0;
        border-color: rgba(200, 188, 170, 0.45);
    }

    .recognition-card--text-only {
        grid-template-columns: 1fr;
    }

    .recognition-card__visual {
        width: 4.5rem;
        height: 4.5rem;
        flex-shrink: 0;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(200, 188, 170, 0.45);
        background: rgba(255, 255, 255, 0.65);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .recognition-card__visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .recognition-card__content {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        font-family: 'Space Grotesk', sans-serif;
    }

    .recognition-year {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: rgba(90, 80, 72, 0.65);
    }

    .recognition-card__title {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: clamp(0.82rem, 2vw, 0.95rem);
        color: #1c1917;
        line-height: 1.25;
        letter-spacing: -0.02em;
    }

    .recognition-detail {
        margin: 0;
        font-size: 0.8rem;
        line-height: 1.45;
        color: rgba(55, 48, 40, 0.82);
        overflow-wrap: anywhere;
    }

    .recognition-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 0.65rem;
        margin-top: 0.25rem;
    }

    .works-shell .work-link {
        color: #6d28d9;
        text-decoration: none;
        position: relative;
        font-weight: 600;
        font-size: 0.82rem;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        border-bottom: 1px solid rgba(202, 138, 4, 0.55);
        padding-bottom: 1px;
    }

    .works-shell .work-link:hover {
        color: #5b21b6;
        border-bottom-color: rgba(202, 138, 4, 0.85);
    }

    .works-shell .work-link::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 1px;
        bottom: -2px;
        left: 0;
        background: #7c3aed;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease;
    }

    .works-shell .work-link:hover::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    @media (max-width: 900px) {
        .recognition-grid {
            grid-template-columns: 1fr;
        }

        .recognition-card {
            grid-template-columns: auto 1fr;
        }
    }

    @media (max-width: 768px) {
        .works-shell {
            padding: 5.5rem 0.85rem 2.25rem;
            gap: 2.5rem;
        }

        .journey-card__meta {
            justify-content: flex-start;
        }

        .recognition-card {
            grid-template-columns: 1fr;
        }

        .recognition-card__visual {
            width: 100%;
            height: 140px;
            max-width: 100%;
        }

        .recognition-card__visual img {
            object-fit: contain;
            padding: 0.5rem;
        }
    }

    @media (max-width: 480px) {
        .works-shell {
            padding: 5.25rem 0.75rem 1.85rem;
            gap: 2.1rem;
        }

        .journey-card {
            padding: 0.9rem 0.85rem;
        }
    }
</style>
