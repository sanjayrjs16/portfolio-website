---
interface WorkItem {
    type: 'featured' | 'project';
    title: string;
    description: string;
    image?: string;
    link?: string;
    github?: string;
    techStack?: string[];
    launchedBy?: string;
    awards?: string[];
    size?: 'large' | 'medium' | 'small';
    mediaLinks?: { title: string; url: string }[];
}

interface Props {
    currentSection: keyof typeof sectionContent;
}

const { currentSection } = Astro.props;

// Placeholder content for each section
const sectionContent: Record<string, WorkItem[]> = {
    'notable-work': [
        {
            type: 'project',
            title: 'Aadujeevitham: The Goat Life Official Movie Website (2024)',
            description: 'Official movie website for the epic survival drama starring Prithviraj Sukumaran. The website features a dynamic day/night experience that changes based on user\'s local time, with custom animations and transitions.',
            image: '/goat.webp',
            link: 'https://thegoatlifefilm.com',
            launchedBy: 'A R Rahman',
            // techStack: ['Astro', 'React', 'TypeScript', 'Three.js', 'GSAP', 'Tailwind CSS'],
            size: 'large',
            mediaLinks: [
                {
                    title: 'The Hindu - A R Rahman launches Aadujeevitham website',
                    url: 'https://www.thehindu.com/entertainment/movies/ar-rahman-launches-website-of-prithviraj-sukumarans-aadujeevitham/article67679145.ece'
                },
                {
                    title: 'Manorama Online - Immersive website experience',
                    url: 'https://www.manoramaonline.com/movies/movie-news/2023/12/21/ar-rahman-launches-aadujeevitham-movie-website.html'
                }
            ],
            // awards: ['Featured on Awwwards', 'Site of the Day - CSS Design Awards'],
        },
        {
            type: 'project',
            title: 'OHC Network Chatbot',
            description: 'Build a COVID-19 info chatbot for OHC Network that provided real-time updates & guidance aiding the efforts of Government of Kerala during the pandemic, operating on platforms like Facebook Messenger and Telegram.',
            github: 'https://github.com/ohcnetwork/bot',
            image: 'https://ohc.network/ohc_logo_white.svg',
            techStack: ['Python', 'Rasa framework', 'Docker', 'Github Actions', 'Heroku'],
            link: 'https://www.youtube.com/watch?v=A81YflXaZKQ',
            size: 'medium'
        },
        {
            type: 'project',
            title: 'Picturama-DeFi',
            description: 'Decentralized film funding platform built for <span class="highlight-text">Chainlink Fall 2021 Hackathon</span>. Enables direct audience participation in indie cinema financing using Ethereum smart contracts. Won a Filecoin pool prize from Protocol Labs for its use of IPFS storage.',
            github: 'https://github.com/picturama-defi',
            image: 'https://sanjayrjs.vercel.app/picturama.png',
            techStack: ['Next.js', 'Express.js', 'MongoDB', 'Solidity', 'IPFS',  'Web3.js', 'Chainlink', 'Filecoin'],
            link: 'https://www.youtube.com/watch?v=mnrl5tAp7eE&t=160s',
            awards: ['Filecoin Prize Winner - Chainlink 2021 Hackathon'],
            size: 'small'
        }
    ],
    'personal-projects': [],
    'professional': [],
    'videos': []
} as const;
---

<div class="works-content">
 
        {sectionContent[currentSection]?.filter(item => item.size === 'large').map(item => (
            <div class="project-card glass-card full-image-card" style="--delay: 0.1s">
                <div class="card-image">
                    <img src={item.image} alt={item.title} width="330px"/>
                    <div class="image-overlay">
                        <div class="card-header">
                        <h2 class="title-text">{item.title}</h2>
                        </div>
                        <div class="card-content">
                            <p class="description-text">
     As part of the film's core digital team, I served as the web engineer overseeing the site’s architecture, development, and launch of the official movie promotional website.  The website was officially launched by <span class="highlight-text">A. R. Rahman</span>, <span class="highlight-text">Blessy</span>, and author <span class="highlight-text">Benjamin</span> as part of the global marketing rollout. 
</p>

                            
                            <div class="card-links">
                                <a href={item.link} class="highlight-link" target="_blank" rel="noopener noreferrer">
                                    Visit Website →
                                </a>
                                <a class="highlight-link" href="https://timesofindia.indiatimes.com/entertainment/malayalam/movies/news/director-blessy-on-aadujeevitham-website-launch/articleshow/108015198.cms" target="_blank" rel="noopener noreferrer">Times of India</a>
                                <a class="highlight-link" href="https://indianexpress.com/article/entertainment/malayalam/ar-rahman-prithviraj-sukumaran-upcoming-film-aadujeevitham-malayalam-lawrence-of-arabia-9183502/" target="_blank" rel="noopener noreferrer">Indian Express</a>
                                <a class="highlight-link" href="https://en.wikipedia.org/wiki/The_Goat_Life#Marketing:~:text=An%20official%20website,Revenant%20(2015)" target="_blank" rel="noopener noreferrer">Wikipedia</a>
                                <a class="highlight-link" href="https://www.mathrubhumi.com/movies-music/news/aadujeevitham-website-launch-1.9357830" target="_blank" rel="noopener noreferrer">Mathrubhumi</a>
                                <a class="highlight-link" href="https://www.manoramaonline.com/music/music-news/2024/02/26/aadujeevitham-website-opening.html" target="_blank" rel="noopener noreferrer">Manorama Online</a>
                            </div>

                            {item.awards && (
                                <div class="awards">
                                    {item.awards.map(award => (
                                        <span class="award-tag">🏆 {award}</span>
                                    ))}
                                </div>
                            )}

                            <div class="card-links">
                               
                            </div>

                            {item.techStack && (
                                <div class="tech-stack">
                                    {item.techStack.map(tech => <span class="tech-tag">{tech}</span>)}
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            </div>
        ))}
  
        {sectionContent[currentSection]?.filter(item => item.size === 'small' || item.size === 'medium').map(item => item.size === 'small' ? (
        
                
                <div class="project-card glass-card" style="--delay: 0.3s">
                    
                    <div style="display: flex; width: 100%; gap: 0.5rem; align-items: center; justify-content: space-between">
                   
                        <div class="card-header">
                        <h2 class="title-text">{item.title}</h2>
                    </div> {item.image && (
                        <div class="project-image">
                            <img src={item.image} alt={item.title} width="100px"/>
                        </div>
                    )}
                  
                   
                </div>
                <p class="description-text">Decentralized film funding platform built for <span class="highlight-text">Chainlink Fall 2021 Hackathon</span>. Enables direct audience participation in indie cinema financing using Ethereum smart contracts. Won a Filecoin pool prize from <span class="highlight-text">Protocol Labs</span> for its use of IPFS storage.</p>
                   
                    {item.awards && (
                        <div class="awards">
                            {item.awards.map(award => (
                                <span class="award-tag">🏆 {award}</span>
                            ))}
                        </div>
                    )}
                    <div class="card-links">
                        <a href={item.github} class="highlight-link" target="_blank" rel="noopener noreferrer">
                            <svg class="github-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                            </svg>
                            View Source
                        </a>
                        {item.link && (
                            <a href={item.link} class="highlight-link" target="_blank" rel="noopener noreferrer">
                                Watch Demo →
                            </a>
                        )}
                    </div>
                    {item.techStack && (
                        <div class="tech-stack">
                            {item.techStack.map(tech => <span class="tech-tag">{tech}</span>)}
                        </div>
                    )}
                </div>
        
        ):( <div class="project-card glass-card" style="--delay: 0.2s">
                        <div style="display: flex; width: 100%; gap: 0.5rem; align-items: center; justify-content: space-between">
                            <div class="card-header"> <h2 class="title-text">{item.title}</h2></div>
                        {item.image && (
                            <div class="project-image">
                                <img src={item.image} alt={item.title} />
                            </div>
                        )} 
                       </div>
                        <div class="card-header">
                            <p class="description-text">Build a COVID-19 info chatbot for <span class="highlight-text">OHC Network</span> that provided real-time updates & guidance aiding the efforts of <span class="highlight-text">Government of Kerala</span> during the pandemic, operating on platforms like <span class="highlight-text">Facebook Messenger</span> and <span class="highlight-text">Telegram</span>.</p>
                       
                      
                            <span class="badge" >
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                                Open Source Contribution
                            </span>
                        </div>
                        {item.awards && (
                            <div class="awards" >
                                {item.awards.map(award => (
                                    <span class="award-tag">🏆 {award}</span>
                                ))}
                            </div>
                        )}
                        <div class="card-links">
                            <a href={item.github} class="highlight-link" target="_blank" rel="noopener noreferrer">
                                <svg class="github-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                                View Source
                            </a>
                            {item.link && (
                                <a href={item.link} class="highlight-link" target="_blank" rel="noopener noreferrer">
                                    Watch Demo →
                                </a>
                            )}
                        </div>
                        {item.techStack && (
                            <div class="tech-stack">
                                {item.techStack.map(tech => <span class="tech-tag">{tech}</span>)}
                            </div>
                        )}
                    </div>))}
   
</div>

<style>
   
    .works-content {
        display: flex;
        /* flex: 0 0 33.33%; */
        /* flex-wrap: wrap; */
        /* grid-template-columns: 2fr 1fr; */
        align-items: stretch;
        gap: 1rem;
        padding: 1rem;
        max-width: 1600px;
        margin: 0 auto;
        overflow-y: auto;
    }

    .left-column {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .right-column{
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .large {
        min-height: 10vmin;
    }

    .medium {
        min-height: 220px;
        max-width: 35vw;
    }

    .small {
        min-height: 180px;
    }

    .project-image {
        height: 50px;
        min-width: 100px;
        padding: 0.75rem 0.75rem 0.25rem;
    }

    .project-image img {
        max-height: 100%;
        /* width: auto; */
        border-radius: 4rem;
        object-fit: cover;
    }

    .featured-card, .project-card {
        background: rgba(2, 2, 0, 0.82);
        backdrop-filter: blur(2px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 
            0 4px 30px rgba(0, 0, 0, 0.1),
            inset 0 0 0 1px rgba(255, 255, 255, 0.05);
            overflow: hidden;
        border-radius: 8px;
        /* box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); */
        padding: 0.75rem;
        color: white;
        max-width: 33vw;
        opacity: 0;
        animation: fadeIn 0.6s ease forwards;
        animation-delay: var(--delay, 0s);
    }

    

 

    .card-image img {
        width: fit-content;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .featured-card:hover .card-image img {
        transform: scale(1.05);
    }



 
    .card-header .title-text {
        font-size: clamp(1rem, 1.5vw, 1.3rem);
        font-family: 'Space Grotesk', sans-serif;
        text-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        text-align: left;
        text-transform: uppercase;
        line-height: 1;
        margin-bottom: 0.5rem;
        opacity: 0;
        animation: fadeIn 0.5s ease-out forwards;
        animation-delay: calc(var(--index) * 0.1s);
        animation-fill-mode: forwards;
    }

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(-10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
    .card-links  {
        margin: 0.8rem 0;
        display: flex;
        flex-wrap: wrap;
        flex: 1 0 100%;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Space Grotesk', sans-serif;
      
        
        /* animation-fill-mode: forwards; */
    }

    .github-icon {
        opacity: 0.8;
        transition: opacity 0.3s ease;
    }

    .github-icon {
        opacity: 1;
    }

    .tech-stack {
        padding-top: 0.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
    }

    .tech-tag {
        background: rgba(138, 43, 226, 0.1);
        color: rgba(255, 255, 255, 0.9);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-family: 'Space Grotesk', sans-serif;
        border: 1px solid rgba(138, 43, 226, 0.2);
    }

    .awards {
        margin: 0.5rem 0;
        gap: 0.25rem;
    }

    .award-tag {
        background: rgba(255, 215, 0, 0.1);
        color: rgba(255, 215, 0, 0.9);
        padding: 0.3rem 0.8rem;
        border-radius: 4px;
        font-size: 0.65rem;
        text-transform: uppercase;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        border: 1px solid rgba(255, 215, 0, 0.2);
        font-family: 'Syncopate', sans-serif;
    }

    .badge {
        display: inline-flex;
        text-transform: uppercase;
        align-items: center;
        gap: 0.5rem;
        background: rgba(46, 204, 113, 0.1);
        color: rgba(46, 204, 113, 0.9);
        padding: 0.3rem 0.8rem;
        border-radius: 4px;
        font-size: 0.65rem;
        border: 1px solid rgba(46, 204, 113, 0.2);
        margin-bottom: 1rem;
        font-family: 'Syncopate', sans-serif;
    }

    .description-text {
        margin: 0.5rem 0;
        font-size: 0.9rem;
        line-height: 1.3;
    }

    @media (max-width: 1200px) {
       
        .large {
            min-height: 20vmin;
        }
    }

    @media (max-width: 768px) {
       
   

      .works-content {
    flex-direction: column;
    max-width: 100vw;
    padding: 0.5rem;
    gap: 0.5rem;
  }
  .project-card, .featured-card {
    max-width: 100%;
    width: 100%;
  }
  .card-image {
    min-height: 10rem; /* or something smaller for mobile */
  }
    }

    .compact {
        padding: 1rem;
        margin-bottom: 1rem;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        min-width: 60vw;
    }

    .media-links {
        display: flex;
        /* flex-direction: column; */
        gap: 0.5rem;
        margin: 0.75rem 0;
        flex-wrap: wrap;
    }

    .media-link {
        color: rgba(255, 255, 255, 0.9);
        text-decoration: none;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
        transition: all 0.3s ease;
    }

    .media-link:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateX(5px);
    }
   
    .description-text {
        margin: 0.5rem 0;
        font-size: 0.9rem;
        line-height: 1.3;
    }

    .highlight-link {
        color: rgba(255, 255, 255, 0.9);
        text-decoration: none;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
        transition: all 0.3s ease;
       
    }

    .highlight-link:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateX(5px);
    }

    .full-image-card {
        position: relative;
        overflow: hidden;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        /* height: 400px; Ensure the card has a fixed height */
    }

    .card-image {
        position: relative;
        width: 100%;
        height: 100%; /* Make sure the image fills the card */
        /* overflow: hidden; */
        min-height: 22rem;
        height: auto; 
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        
    }

    .image-overlay {
        position: absolute;
        top: 0;
        left: -10px;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        overflow-y: auto;
        padding-bottom: 1rem;
        padding: 1rem;
        background: linear-gradient(to bottom, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.7));
    }


    .card-content {
        color: white;
        padding: 0.1rem;
    }

    .description-text {
        margin: 0.5rem 0;
        font-size: 0.9rem;
        line-height: 1.3;
    }


