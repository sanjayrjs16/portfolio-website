---
import type { FeaturedProject } from './workProjectTypes';

interface Props {
    project: FeaturedProject;
}

const { project } = Astro.props;
const summaryParts = project.summary.split(/\n\n+/).map((s) => s.trim()).filter(Boolean);
---

<article
    class:list={[
        'featured-card',
        { 'featured-card--cinematic': project.tone === 'cinematic' },
        { 'featured-card--interactive': project.caseStudyPath },
        { 'featured-card--has-study': project.caseStudyPath }
    ]}
    data-slug={project.slug}
>
    {
        project.caseStudyPath && (
            <a class="featured-card__hit" href={project.caseStudyPath}>
                <span class="sr-only">View details: {project.title}</span>
            </a>
        )
    }
    <div
        class:list={[
            'featured-card__media',
            { 'featured-card__media--sunroad-warm': project.mediaVariant === 'sunroad-warm' },
            { 'featured-card__media--logo-contain': project.mediaVariant === 'logo-contain' }
        ]}
    >
        <img
            src={project.image}
            alt=""
            class="featured-card__img"
            width={800}
            height={520}
            loading="lazy"
            decoding="async"
        />
        {
            project.caseStudyPath && project.caseStudyCta && (
                <a class="featured-card__cta featured-card__cta--media" href={project.caseStudyPath}>
                    <span>{project.caseStudyCta}</span>
                    <span class="featured-card__cta-arrow" aria-hidden="true">
                        →
                    </span>
                </a>
            )
        }
    </div>
    <div class="featured-card__body">
        {
            project.metrics && project.metrics.length > 0 && (
                <p class="featured-card__meta">
                    {project.metrics.map((m) => (
                        <span class="meta-pill">{m}</span>
                    ))}
                </p>
            )
        }
        <h3 class="featured-card__title">{project.title}</h3>
        <p class="featured-card__role">{project.role}</p>
        <div class="featured-card__summaries">
            {summaryParts.map((text) => (
                <p class="featured-card__summary">{text}</p>
            ))}
        </div>
        <div class="featured-card__links">
            {project.links.map((link) => (
                <a class="work-link work-link--light" href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.label}
                </a>
            ))}
        </div>
        <p class="featured-card__stack" aria-label="Tech stack">
            {project.stack.map((tech) => (
                <span class="stack-pill">{tech}</span>
            ))}
        </p>
    </div>
    {
        project.caseStudyPath && (
            <span class="card-open-icon" aria-hidden="true" title="Open case study">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
            </span>
        )
    }
</article>

<style>
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .featured-card {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
        gap: 0;
        min-width: 0;
        width: 100%;
        max-width: 100%;
        background: linear-gradient(168deg, rgba(252, 250, 246, 0.97) 0%, rgba(236, 232, 226, 0.94) 100%);
        backdrop-filter: blur(18px) saturate(1.12);
        border: 1px solid rgba(200, 188, 170, 0.5);
        border-radius: 16px;
        overflow: hidden;
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.07),
            0 6px 28px rgba(20, 12, 40, 0.1),
            inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .featured-card--cinematic {
        border-color: rgba(212, 175, 55, 0.35);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.1),
            0 0 40px rgba(124, 58, 237, 0.08),
            0 8px 32px rgba(20, 12, 40, 0.12),
            inset 0 1px 0 rgba(255, 255, 255, 0.75);
    }

    .featured-card__hit {
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: inherit;
    }

    .featured-card__hit:focus-visible {
        outline: 2px solid rgba(124, 58, 237, 0.65);
        outline-offset: 2px;
    }

    .card-open-icon {
        position: absolute;
        top: 0.6rem;
        right: 0.6rem;
        z-index: 3;
        pointer-events: none;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.4rem;
        border-radius: 10px;
        color: rgba(68, 58, 48, 0.55);
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(190, 178, 160, 0.45);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    }

    .featured-card--interactive:hover .card-open-icon {
        color: #6d28d9;
        border-color: rgba(124, 58, 237, 0.35);
    }

    .featured-card__media {
        min-width: 0;
        min-height: 220px;
        max-height: 340px;
        position: relative;
        z-index: 0;
        background: linear-gradient(165deg, #ebe6e0, #e0d9d1);
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.6rem;
    }

    /* Premium framed media (Goat Life / Sun Road / OHC) */
    .featured-card[data-slug='goat-life'] .featured-card__media,
    .featured-card[data-slug='sunroad'] .featured-card__media,
    .featured-card[data-slug='ohc-network'] .featured-card__media {
        padding: clamp(0.7rem, 2vw, 1.15rem);
        align-items: center;
    }

    .featured-card[data-slug='goat-life'] .featured-card__img,
    .featured-card[data-slug='sunroad'] .featured-card__img,
    .featured-card[data-slug='ohc-network'] .featured-card__img {
        object-fit: contain;
        border-radius: 12px;
        border: 1px solid rgba(200, 188, 170, 0.35);
        background: rgba(255, 255, 255, 0.55);
    }

    /* Goat Life: wide artwork should fill the frame (slight crop) */
    .featured-card[data-slug='goat-life'] .featured-card__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .featured-card[data-slug='goat-life'] .featured-card__cta--media,
    .featured-card[data-slug='sunroad'] .featured-card__cta--media,
    .featured-card[data-slug='ohc-network'] .featured-card__cta--media {
        align-self: center;
        margin-top: 0.05rem;
    }

    /* Hide skills row for featured cards as requested */
    .featured-card[data-slug='goat-life'] .featured-card__stack,
    .featured-card[data-slug='sunroad'] .featured-card__stack {
        display: none;
    }

    /* Dark mode: only invert the media (image) surface */
    :global(html[data-theme='dark'] .featured-card__media) {
        background: linear-gradient(165deg, rgba(18, 18, 24, 0.92), rgba(30, 30, 38, 0.88));
    }

    .featured-card__media--sunroad-warm {
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(180deg, #faf9f6 0%, #f8f6f2 45%, #f2efe8 100%);
        box-shadow: inset 0 0 0 1px rgba(200, 188, 170, 0.35);
    }

    :global(html[data-theme='dark'] .featured-card__media--sunroad-warm) {
        /* Match Sun Road case study dark surface (slightly brighter) */
        background: linear-gradient(165deg, rgba(30, 30, 38, 0.84) 0%, rgba(18, 18, 24, 0.82) 100%);
        box-shadow: inset 0 0 0 1px rgba(168, 85, 247, 0.18);
    }

    .featured-card__media--sunroad-warm .featured-card__img {
        flex: 1;
        width: 100%;
        height: 100%;
        max-height: 100%;
        object-fit: contain;
        object-position: center;
        padding: 0;
    }

    /* Full logo visible — no cover crop (e.g. OHC Network) */
    .featured-card__media--logo-contain {
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(158deg, #f5f3ef 0%, #ebe8e2 100%);
        padding: clamp(0.7rem, 2vw, 1.15rem);
        min-height: 200px;
        max-height: 270px;
        box-shadow: inset 0 0 0 1px rgba(200, 188, 170, 0.28);
    }

    :global(html[data-theme='dark'] .featured-card__media--logo-contain) {
        background: linear-gradient(158deg, rgba(20, 20, 26, 0.92) 0%, rgba(28, 28, 36, 0.88) 100%);
        box-shadow: inset 0 0 0 1px rgba(168, 85, 247, 0.16);
    }

    .featured-card__media--logo-contain .featured-card__img {
        width: auto;
        height: auto;
        max-width: min(94%, 420px);
        max-height: min(220px, 78%);
        object-fit: contain;
        object-position: center;
    }

    .featured-card--interactive {
        transition:
            transform 0.28s ease,
            box-shadow 0.28s ease,
            border-color 0.28s ease;
    }

    .featured-card--interactive:hover {
        transform: translateY(-3px);
        border-color: rgba(180, 160, 130, 0.55);
        box-shadow:
            0 0 0 1px rgba(124, 58, 237, 0.12),
            0 14px 40px rgba(20, 12, 40, 0.14);
    }

    .featured-card__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 0.15rem;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: #5b21b6;
        text-decoration: none;
        border-bottom: 1px solid rgba(202, 138, 4, 0.55);
        padding-bottom: 0.12rem;
        width: fit-content;
        max-width: 100%;
        pointer-events: auto;
        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            gap 0.2s ease;
    }

    .featured-card__cta--media {
        margin-top: 0;
        pointer-events: auto;
    }

    .featured-card__cta:hover {
        color: #4c1d95;
        border-bottom-color: rgba(202, 138, 4, 0.9);
    }

    .featured-card__cta-arrow {
        transition: transform 0.22s ease;
    }

    .featured-card__cta:hover .featured-card__cta-arrow {
        transform: translateX(4px);
    }

    .featured-card__img {
        width: 100%;
        height: 100%;
        max-width: 100%;
        object-fit: cover;
        display: block;
    }

    .featured-card__body {
        min-width: 0;
        padding: 1.1rem 1.15rem 1.2rem;
        padding-right: 2.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        font-family: 'Space Grotesk', sans-serif;
        position: relative;
        z-index: 2;
        pointer-events: none;
    }

    .featured-card__meta {
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .meta-pill {
        font-size: 0.62rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgba(91, 33, 182, 0.92);
        border: 1px solid rgba(124, 58, 237, 0.28);
        background: rgba(139, 92, 246, 0.08);
        padding: 0.2rem 0.5rem;
        border-radius: 999px;
    }

    .featured-card__title {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: clamp(0.98rem, 2.2vw, 1.14rem);
        line-height: 1.25;
        letter-spacing: -0.02em;
        color: #1c1917;
    }

    .featured-card__role {
        margin: 0;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: rgba(80, 72, 64, 0.72);
    }

    .featured-card__summaries {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
    }

    .featured-card__summary {
        margin: 0;
        font-size: 0.87rem;
        line-height: 1.52;
        color: rgba(40, 36, 33, 0.9);
        overflow-wrap: anywhere;
    }

    .featured-card__stack {
        margin: 0.15rem 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
    }

    .stack-pill {
        font-size: 0.6rem;
        font-weight: 500;
        padding: 0.14rem 0.38rem;
        border-radius: 6px;
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(124, 58, 237, 0.22);
        color: rgba(76, 29, 149, 0.9);
    }

    .featured-card__links {
        margin-top: 0.35rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 0.65rem;
        align-items: center;
    }

    .work-link--light {
        color: #6d28d9;
        text-decoration: none;
        position: relative;
        font-weight: 600;
        font-size: 0.82rem;
        font-family: 'Space Grotesk', sans-serif;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        border-bottom: 1px solid rgba(202, 138, 4, 0.55);
        padding-bottom: 1px;
        pointer-events: auto;
    }

    .work-link--light:hover {
        color: #5b21b6;
        border-bottom-color: rgba(202, 138, 4, 0.85);
    }

    @media (max-width: 960px) {
        .featured-card {
            grid-template-columns: 1fr;
        }

        .featured-card__media {
            max-height: 240px;
            min-height: 200px;
        }

        .featured-card__media--logo-contain {
            max-height: 220px;
            min-height: 168px;
        }

        .featured-card__media--logo-contain .featured-card__img {
            max-height: min(200px, 72%);
        }

        .featured-card__body {
            padding-right: 1.15rem;
        }
    }

    @media (max-width: 520px) {
        .featured-card__body {
            padding: 0.8rem 0.85rem;
            padding-right: 2.35rem;
        }

        .card-open-icon {
            top: 0.5rem;
            right: 0.5rem;
        }

        /* Mobile: center-aligned layout with justified copy for cleaner reading */
        .featured-card__body {
            align-items: center;
            text-align: center;
        }

        .featured-card__meta,
        .featured-card__links,
        .featured-card__stack {
            justify-content: center;
        }

        .featured-card__summary {
            text-align: center;
            text-align-last: center;
        }

        /* Match compact mobile typography used by stack/supabase cards */
        .featured-card__title {
            font-size: 0.95rem;
            line-height: 1.22;
        }

        .featured-card__role {
            font-size: 0.64rem;
            letter-spacing: 0.06em;
        }

        .featured-card__summary {
            font-size: 0.8rem;
            line-height: 1.45;
            letter-spacing: 0;
        }

        .featured-card__cta {
            font-size: 0.72rem;
            letter-spacing: 0.08em;
        }

        .work-link--light {
            font-size: 0.78rem;
        }
    }
</style>
