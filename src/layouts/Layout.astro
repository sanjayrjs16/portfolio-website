---
import Navigation from '../components/Navigation/Navigation.astro';
// import NotificationProvider from '../context/NotificationContext';
// import NotificationButtonsContainer from '../components/Notification/NotificationButtonsContainer';
import '../styles/global.css';
import '../styles/notifications.css';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = '/stardust-avatar.png' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Sanjay Rajesh" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={Astro.url.href} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:site_name" content="Sanjay Rajesh" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.url)} />

		<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&display=swap" rel="stylesheet">
	</head>
	<body>
		<Navigation />
		<slot />
		<!-- <NotificationProvider client:only="react">
			<NotificationButtonsContainer client:only="react"/>
		</NotificationProvider>
		<div id="notification-root"></div> -->
		<script>
			// Reset scroll position on page load
			window.history.scrollRestoration = 'manual';
				window.scrollTo(0, 0);
			</script>
	</body>
</html>

<style is:global>
		@import url('https://fonts.googleapis.com/css2?family=Audiowide&display=swap');
	@import url('https://fonts.googleapis.com/css2?family=Syncopate:wght@700&display=swap');
	@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap');

	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}

	html {
		/* font-family: system-ui, sans-serif; */
		background: #000000;
		background-size: 224px;
	}

	body {
		margin: 0;
		padding: 0;
		min-height: 100dvh;
		width: 100%;
	}

	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
</style>
