---
const title = 'Supabase Creator Recognition';
const summary =
    'Supabase Creator Recognition (2026) for content on mitigating AI Agent and MCP prompt injection risks.';
const photoSrc = '/supabase_recognision.jpeg';
const logoSrc = '/supabase-logo.svg';

const links = [
    { label: 'YouTube video', url: 'https://www.youtube.com/watch?v=1ibf5SxkMMI' },
    {
        label: 'LinkedIn post',
        url: 'https://www.linkedin.com/posts/sanjay-rajesh_supabase-security-ai-activity-7424340378407018497-ZU0-/'
    }
] as const;
---

<article class="sb-card" data-slug="supabase-recognition">
    <div class="sb-card__top">
        <div class="sb-card__logo-wrap">
            <img class="sb-card__logo" src={logoSrc} alt="" width="48" height="50" loading="lazy" decoding="async" />
        </div>
        <div class="sb-card__copy">
            <h3 class="sb-card__title">{title}</h3>
            <p class="sb-card__summary">{summary}</p>
            <div class="sb-card__links">
                {links.map((link) => (
                    <a class="work-link work-link--light" href={link.url} target="_blank" rel="noopener noreferrer">
                        {link.label}
                    </a>
                ))}
            </div>
        </div>
    </div>
    <div class="sb-card__photo">
        <img src={photoSrc} alt="" width={800} height={600} loading="lazy" decoding="async" />
    </div>
</article>

<style>
    .sb-card {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 0;
        overflow: hidden;
        background: linear-gradient(168deg, rgba(252, 250, 246, 0.96), rgba(236, 232, 226, 0.93));
        border: 1px solid rgba(200, 188, 170, 0.48);
        border-radius: 14px;
        backdrop-filter: blur(16px);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.06),
            0 4px 22px rgba(20, 12, 40, 0.09),
            inset 0 1px 0 rgba(255, 255, 255, 0.65);
        font-family: 'Space Grotesk', sans-serif;
    }

    .sb-card__top {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 0.75rem;
        align-items: start;
        padding: 0.85rem 1rem 0.75rem;
        min-width: 0;
        border-bottom: 1px solid rgba(200, 188, 170, 0.35);
    }

    .sb-card__logo-wrap {
        flex-shrink: 0;
        width: 2.65rem;
        height: 2.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(200, 188, 170, 0.4);
        padding: 0.35rem;
    }

    .sb-card__logo {
        width: 100%;
        height: 100%;
        max-width: 1.85rem;
        max-height: 1.95rem;
        object-fit: contain;
        display: block;
    }

    .sb-card__copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.32rem;
    }

    .sb-card__title {
        margin: 0;
        font-weight: 700;
        font-size: clamp(0.82rem, 1.9vw, 0.95rem);
        line-height: 1.22;
        letter-spacing: -0.02em;
        color: #1c1917;
    }

    .sb-card__summary {
        margin: 0;
        font-size: 0.76rem;
        line-height: 1.42;
        color: rgba(55, 48, 40, 0.84);
        overflow-wrap: anywhere;
    }

    .sb-card__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem 0.55rem;
        margin-top: 0.15rem;
    }

    .work-link--light {
        color: #6d28d9;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.78rem;
        overflow-wrap: anywhere;
        border-bottom: 1px solid rgba(202, 138, 4, 0.55);
        padding-bottom: 1px;
    }

    .work-link--light:hover {
        color: #5b21b6;
        border-bottom-color: rgba(202, 138, 4, 0.85);
    }

    .sb-card__photo {
        flex: 0 0 auto;
        min-width: 0;
        width: 100%;
        max-width: 100%;
        background: linear-gradient(180deg, rgba(245, 243, 240, 0.95) 0%, rgba(235, 232, 226, 0.9) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 0.85rem 0.7rem;
    }

    .sb-card__photo img {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: clamp(7.35rem, 20vw, 10.95rem);
        object-fit: contain;
        object-position: center;
        display: block;
    }

    @media (max-width: 960px) {
        .sb-card__photo img {
            max-height: clamp(7rem, 24vw, 7.85rem);
        }
    }

    @media (max-width: 520px) {
        .sb-card__top {
            grid-template-columns: 1fr;
            padding: 0.75rem 0.85rem 0.65rem;
            gap: 0.55rem;
        }

        .sb-card__logo-wrap {
            width: 2.5rem;
            height: 2.6rem;
        }

        .sb-card__photo {
            padding: 0.45rem 0.65rem 0.65rem;
        }

        .sb-card__photo img {
            max-width: 100%;
            max-height: clamp(6.5rem, 42vw, 7.25rem);
        }
    }
</style>
