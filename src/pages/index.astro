<script>
	// Add this to handle fallback visibility
	function handleCanvasMount() {
		const canvas = document.querySelector('canvas');
		const fallback = document.querySelector('.background-fallback');
		
		if (canvas && fallback) {
			fallback.classList.add('hidden');
			// Optional: Remove fallback after transition
			setTimeout(() => {
				fallback.remove();
			}, 300);
		}
	}

	// Check periodically until canvas is mounted
	const checkInterval = setInterval(() => {
		if (document.querySelector('canvas')) {
			handleCanvasMount();
			clearInterval(checkInterval);
		}
	}, 100);
</script>