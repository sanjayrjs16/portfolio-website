---
import StarryLayout from '../../layouts/StarryLayout.astro';

interface Props {
    title: string;
    description: string;
    /** Short label after "Works / …" */
    breadcrumbCurrent: string;
}

const { title, description, breadcrumbCurrent } = Astro.props;
---

<StarryLayout title={title} description={description}>
    <article class="case-light">
        <div class="case-light__nav">
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <ol class="breadcrumb__list">
                    <li>
                        <a class="breadcrumb__link" href="/works">Works</a>
                    </li>
                    <li class="breadcrumb__sep" aria-hidden="true">></li>
                    <li>
                        <span class="breadcrumb__current" aria-current="page">{breadcrumbCurrent}</span>
                    </li>
                </ol>
            </nav>
            <a class="case-light__back" href="/works">← Back to Works</a>
        </div>
        <slot />
    </article>
</StarryLayout>

<style>
    .case-light {
        width: 100%;
        max-width: min(52rem, 100%);
        margin: 0 auto;
        padding: 5.25rem max(1rem, env(safe-area-inset-right)) 3rem max(1rem, env(safe-area-inset-left));
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        overflow-x: clip;
        font-family: 'Space Grotesk', sans-serif;
    }

    .case-light *,
    .case-light *::before,
    .case-light *::after {
        box-sizing: border-box;
    }

    .case-light__nav {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.55rem;
        min-width: 0;
        width: 100%;
        margin-bottom: 0.15rem;
        padding: 0.72rem 0.85rem;
        border-radius: 14px;
        background: linear-gradient(165deg, rgba(252, 250, 246, 0.94) 0%, rgba(238, 234, 228, 0.9) 100%);
        border: 1px solid rgba(200, 188, 170, 0.45);
        backdrop-filter: blur(18px) saturate(1.15);
        -webkit-backdrop-filter: blur(18px) saturate(1.15);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.08),
            0 4px 24px rgba(20, 12, 40, 0.12),
            inset 0 1px 0 rgba(255, 255, 255, 0.65);
        position: relative;
        z-index: 1;
    }

    /* Light-panel link color; on starfield this must match breadcrumb (dark purple is invisible) */
    .case-light__back {
        color: #6d28d9;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.84rem;
        border-bottom: 1px solid rgba(202, 138, 4, 0.55);
        padding-bottom: 1px;
        max-width: 100%;
        overflow-wrap: anywhere;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .case-light__back:hover {
        color: #5b21b6;
        border-bottom-color: rgba(202, 138, 4, 0.85);
    }

    /* Dark mode: invert the back pill + nav container */
    :global([data-theme='dark'] .case-light__nav) {
        background: linear-gradient(165deg, rgba(30, 30, 38, 0.84) 0%, rgba(18, 18, 24, 0.82) 100%);
        border-color: rgba(168, 85, 247, 0.26);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.10),
            0 10px 34px rgba(0, 0, 0, 0.35),
            inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    :global([data-theme='dark'] .case-light__back) {
        color: rgba(217, 85, 242, 0.98);
        border-bottom-color: rgba(217, 85, 242, 0.35);
    }

    :global([data-theme='dark'] .case-light__back:hover) {
        color: rgba(236, 210, 255, 1);
        border-bottom-color: rgba(217, 85, 242, 0.55);
    }

    /* Keep breadcrumb readable in dark mode */
    :global(html[data-theme='dark'] .breadcrumb__link) {
        color: rgba(217, 85, 242, 0.98) !important;
        border-bottom-color: rgba(217, 85, 242, 0.35) !important;
    }

    :global(html[data-theme='dark'] .breadcrumb__link:hover) {
        color: rgba(236, 210, 255, 1) !important;
        border-bottom-color: rgba(217, 85, 242, 0.55) !important;
    }

    :global(html[data-theme='dark'] .breadcrumb__sep) {
        color: rgba(255, 255, 255, 0.55) !important;
    }

    :global(html[data-theme='dark'] .breadcrumb__current) {
        color: rgba(255, 255, 255, 0.92) !important;
    }

    .breadcrumb {
        margin: 0;
        width: 100%;
        min-width: 0;
        align-self: flex-start;
    }

    .breadcrumb__list {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.28rem 0.42rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        line-height: 1.35;
        /* Readable on starfield */
        color: rgba(90, 80, 72, 0.62);
    }

    :global(html[data-theme='dark'] .breadcrumb__list) {
        color: rgba(255, 255, 255, 0.70) !important;
    }

    .breadcrumb__link {
        color: #6d28d9;
        text-decoration: none;
        border-bottom: 1px solid rgba(202, 138, 4, 0.45);
        padding-bottom: 1px;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .breadcrumb__link:hover {
        color: #5b21b6;
        border-bottom-color: rgba(202, 138, 4, 0.75);
    }

    .breadcrumb__sep {
        color: rgba(120, 110, 95, 0.4);
        user-select: none;
        font-weight: 400;
        font-size: 0.65em;
        margin-inline: 0.02rem;
    }

    .breadcrumb__current {
        color: rgba(40, 36, 33, 0.86);
        max-width: 100%;
        overflow-wrap: anywhere;
        font-weight: 500;
    }

    :global(.case-light .light-panel) {
        background: linear-gradient(165deg, rgba(252, 250, 246, 0.96) 0%, rgba(238, 234, 228, 0.92) 100%);
        border: 1px solid rgba(200, 188, 170, 0.48);
        border-radius: 16px;
        backdrop-filter: blur(18px) saturate(1.12);
        padding: 1.2rem 1.25rem;
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.07),
            0 6px 28px rgba(20, 12, 40, 0.1),
            inset 0 1px 0 rgba(255, 255, 255, 0.7);
        min-width: 0;
    }

    :global(.case-light .light-panel--accent) {
        border-color: rgba(212, 175, 55, 0.32);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.09),
            0 8px 32px rgba(20, 12, 40, 0.11),
            inset 0 1px 0 rgba(255, 255, 255, 0.75);
    }

    :global(.case-light .panel-title) {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.02rem, 2.4vw, 1.2rem);
        letter-spacing: -0.02em;
        text-transform: none;
        font-weight: 700;
        color: #1c1917;
    }

    :global(.case-light .panel-text) {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.58;
        color: rgba(40, 36, 33, 0.88);
        overflow-wrap: anywhere;
    }

    :global(.case-light .work-link) {
        color: #6d28d9;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.84rem;
        border-bottom: 1px solid rgba(202, 138, 4, 0.55);
        padding-bottom: 1px;
        overflow-wrap: anywhere;
        align-self: flex-start;
    }

    :global(.case-light .work-link:hover) {
        color: #5b21b6;
        border-bottom-color: rgba(202, 138, 4, 0.85);
    }

    :global([data-theme='dark'] .case-light .light-panel) {
        background: linear-gradient(165deg, rgba(30, 30, 38, 0.84) 0%, rgba(18, 18, 24, 0.82) 100%);
        border-color: rgba(168, 85, 247, 0.26);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.10),
            0 10px 34px rgba(0, 0, 0, 0.35),
            inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    :global([data-theme='dark'] .case-light .light-panel--accent) {
        border-color: rgba(212, 175, 55, 0.20);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.14),
            0 8px 32px rgba(20, 12, 40, 0.18),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    :global([data-theme='dark'] .case-light .panel-title) {
        color: rgba(255, 255, 255, 0.92);
    }

    :global([data-theme='dark'] .case-light .panel-text) {
        color: rgba(255, 255, 255, 0.78);
    }

    :global([data-theme='dark'] .case-light .work-link) {
        color: rgba(217, 85, 242, 0.98);
        border-bottom-color: rgba(217, 85, 242, 0.35);
    }

    :global([data-theme='dark'] .case-light .work-link:hover) {
        color: rgba(236, 210, 255, 1);
        border-bottom-color: rgba(217, 85, 242, 0.55);
    }

    /* Text color pass for page-specific classes (bullet lists, chips, etc.) */
    :global([data-theme='dark'] .case-light .hero-title),
    :global([data-theme='dark'] .case-light .hero__title) {
        color: rgba(255, 255, 255, 0.92);
        text-shadow: none;
    }

    :global([data-theme='dark'] .case-light .hero-role),
    :global([data-theme='dark'] .case-light .hero__subtitle),
    :global([data-theme='dark'] .case-light .lede),
    :global([data-theme='dark'] .case-light .intro-launch__lede),
    :global([data-theme='dark'] .case-light .section-intro),
    :global([data-theme='dark'] .case-light .panel-text.emphasis) {
        color: rgba(255, 255, 255, 0.78);
    }

    :global([data-theme='dark'] .case-light .eyebrow),
    :global([data-theme='dark'] .case-light .hero__eyebrow) {
        color: rgba(195, 140, 255, 0.95);
    }

    :global([data-theme='dark'] .case-light .muted) {
        color: rgba(255, 255, 255, 0.55) !important;
    }

    :global([data-theme='dark'] .case-light .bullet-list),
    :global([data-theme='dark'] .case-light .metric-list),
    :global([data-theme='dark'] .case-light .facts),
    :global([data-theme='dark'] .case-light .work-list) {
        color: rgba(240, 240, 246, 0.86) !important;
    }

    :global([data-theme='dark'] .case-light .tag-list li),
    :global([data-theme='dark'] .case-light .stack-list li) {
        background: rgba(168, 85, 247, 0.12) !important;
        border-color: rgba(168, 85, 247, 0.28) !important;
        color: rgba(236, 210, 255, 0.96) !important;
    }

    :global([data-theme='dark'] .case-light .meta-chip) {
        background: rgba(168, 85, 247, 0.10) !important;
        border-color: rgba(168, 85, 247, 0.30) !important;
        color: rgba(236, 210, 255, 0.96) !important;
    }

    :global([data-theme='dark'] .case-light .press-item__outlet) {
        color: rgba(255, 190, 150, 0.72) !important;
    }

    :global([data-theme='dark'] .case-light .gallery-placeholder) {
        background: rgba(30, 30, 38, 0.55) !important;
        border-color: rgba(168, 85, 247, 0.18) !important;
        color: rgba(255, 255, 255, 0.45) !important;
    }

    @media (max-width: 768px) {
        .case-light {
            padding: 5rem 0.85rem 2.5rem;
            gap: 1.05rem;
        }
    }

    @media (max-width: 480px) {
        .case-light {
            padding: 4.75rem 0.75rem 2rem;
        }

        .breadcrumb__list {
            font-size: 0.68rem;
            gap: 0.25rem 0.35rem;
        }
    }
</style>
