---
const navItems = [
  { path: '/works/', label: 'Works' },
  { path: '/', label: 'Bio' },
  { path: '/posts/', label: 'Posts' },
  // { path: '/contact', label: 'Contact' }
];

const currentPath = Astro.url.pathname;
const showTitle = currentPath !== '/'; // Only show title when not on home/bio page
---

{showTitle && (
  <a href="/" class="brand-title">
    <span class="title-line" data-text="SANJAY">SANJAY</span>
    <span class="title-line" data-text="RAJESH">RAJESH</span>
  </a>
)}

<nav class="navigation">
  {navItems.map(item => (
    <a
      href={item.path}
      class={`nav-item ${currentPath === item.path ? 'active' : ''}`}
    >
      {item.label}
    </a>
  ))}
</nav>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syncopate:wght@700&display=swap');

  .navigation {
    position: fixed;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 100;
    background: linear-gradient(165deg, rgba(252, 250, 246, 0.94) 0%, rgba(238, 234, 228, 0.9) 100%);
    border: 1px solid rgba(200, 188, 170, 0.45);
    box-shadow:
      0 0 0 1px rgba(168, 85, 247, 0.08),
      0 4px 24px rgba(20, 12, 40, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.65);
    padding: 0.38rem 0.42rem;
    border-radius: 14px;
    backdrop-filter: blur(14px);
  }

  .nav-item {
    color: rgba(28, 25, 23, 0.86);
    text-decoration: none;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(0.78rem, 0.9vw, 0.92rem);
    font-weight: 600;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    padding: 0.32rem 0.78rem;
    border-radius: 999px;
    transition: all 0.3s ease;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(200, 188, 170, 0.32);
    backdrop-filter: blur(5px);
    white-space: nowrap;
    animation: navFadeIn 1s ease-out forwards;
  }

  .nav-item:hover {
    color: rgba(28, 25, 23, 0.95);
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(168, 85, 247, 0.3);
    transform: translateY(-2px);
  }

  .nav-item.active {
    background: rgba(139, 92, 246, 0.14);
    color: rgba(76, 29, 149, 0.95);
    border-color: rgba(126, 58, 237, 0.34);
  }

  .brand-title {
    position: fixed;
    top: 2rem;
    left: 2rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    z-index: 100;
    line-height: 0.9;
    opacity: 0;
    animation: navFadeIn 1s ease-out forwards;
    z-index: 200;
    padding: 0.2rem;
    background: rgba(8, 8, 12, 0.7);
    backdrop-filter: blur(3.5px);
    border-radius: 6px;
  }

  .title-line {
    font-family: 'Audiowide', sans-serif;
    font-size: clamp(1rem, 1.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    transform: skew(-5deg);
    background-image: linear-gradient(
      -225deg,
      #c17ce9 0%,
      #fff9fe 29%,
      #e35bf1 67%,
      #c17ce9 100%
    );
    background-size: 200% auto;
    color: #fff;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: textclip 3s linear infinite;
  }

  @keyframes textclip {
    to {
      background-position: 200% center;
    }
  }

  @keyframes navFadeIn {
  from { 
    opacity: 0;
    transform: translateY(-10px); 
  }
  to { 
    opacity: 1;
    transform: translateY(0);
  }
}


  @media (max-width: 768px) {
    .navigation {
      top: 0.45rem;
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      justify-content: center;
      gap: 0.38rem;
      width: max-content;
      max-width: calc(100vw - 1rem);
      margin: 0 auto;
      border-radius: 12px;
      padding: 0.62rem 0.5rem;
      backdrop-filter: blur(8px);
    }

    .nav-item {
      padding: 0.3rem 0.64rem;
      font-size: 0.62rem;
    }

    .brand-title {
      top: 0.95rem;
      left: 0.9rem;
    }

    .title-line {
      font-size: 0.7rem;
    }
  }
</style> 