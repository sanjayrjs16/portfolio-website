---
import { ViewTransitions } from 'astro:transitions';
import Navigation from '../components/Navigation/Navigation.astro';
// import NotificationProvider from '../context/NotificationContext';
// import NotificationButtonsContainer from '../components/Notification/NotificationButtonsContainer';
import '../styles/global.css';
import '../styles/notifications.css';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = '/stardust-avatar.png' } = Astro.props;

const pathname = Astro.url.pathname;
const routeSurface = pathname === '/' || pathname === '' ? 'bio' : 'app';
---

<!doctype html>
<html lang="en" data-route={routeSurface}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Sanjay Rajesh" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={Astro.url.href} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:site_name" content="Sanjay Rajesh" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.url)} />

		<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&display=swap" rel="stylesheet">
		<ViewTransitions />
	</head>
	<body>
		<Navigation />
		<slot />
		<!-- <NotificationProvider client:only="react">
			<NotificationButtonsContainer client:only="react"/>
		</NotificationProvider>
		<div id="notification-root"></div> -->
		<script>
			// Reset scroll position on page load
			window.history.scrollRestoration = 'manual';
			window.scrollTo(0, 0);
		</script>
		<script>
			// @ts-nocheck
			const THEME_KEY = 'theme';

			/** View Transitions can reset html attrs; re-apply saved theme after each navigation */
			function syncThemeFromStorage() {
				const root = document.documentElement;
				const saved = window.localStorage.getItem(THEME_KEY);
				const theme = saved === 'dark' || saved === 'light' ? saved : 'light';
				root.dataset.theme = theme;
				const toggleBtn = document.getElementById('theme-toggle');
				toggleBtn?.setAttribute(
					'aria-label',
					theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
				);
			}

			function syncRouteSurface() {
				const path = window.location.pathname;
				const surface = path === '/' || path === '' ? 'bio' : 'app';
				document.documentElement.dataset.route = surface;
			}

			function syncNavActive() {
				const path = window.location.pathname;
				document.querySelectorAll('.navigation .nav-item').forEach((el) => {
					const href = el.getAttribute('href') || '';
					let active = false;
					if (href === '/' || href === '') {
						active = path === '/' || path === '';
					} else {
						const base = href.replace(/\/$/, '');
						active = path === base || path.startsWith(`${base}/`);
					}
					el.classList.toggle('active', active);
				});
			}

			function onPageLoad() {
				syncThemeFromStorage();
				syncRouteSurface();
				syncNavActive();
			}

			// Single global manager for loading overlay dismissal.
			// Prevents race conditions from multiple per-page scripts during rapid route changes.
			if (!window.__bgFallbackManager) {
				const FADE_MS = 280;
				const REMOVE_AFTER_MS = FADE_MS + 90;
				const POLL_MS = 60;
				const MAX_WAIT_MS = 12000;
				const FORCE_CLEANUP_MS = 2500;

				let pollId = null;
				let pollStartedAt = 0;
				let maxWaitTimer = null;
				let forceCleanupTimer = null;

				const clearPoll = () => {
					if (pollId) {
						window.clearInterval(pollId);
						pollId = null;
					}
					if (maxWaitTimer) {
						window.clearTimeout(maxWaitTimer);
						maxWaitTimer = null;
					}
				};

				const getOverlays = () => Array.from(document.querySelectorAll('.background-fallback'));

				const removeOverlay = (overlay) => {
					if (overlay?.isConnected) overlay.remove();
				};

				const fadeAndRemove = (overlays) => {
					overlays.forEach((overlay) => {
						overlay.classList.add('fade-out');
						window.setTimeout(() => removeOverlay(overlay), REMOVE_AFTER_MS);
					});
				};

				const dismissFallback = ({ force = false } = {}) => {
					const overlays = getOverlays();
					if (overlays.length === 0) {
						clearPoll();
						return;
					}

					const isMobileViewport = window.matchMedia('(max-width: 768px)').matches;
					const hasCanvas = !!document.querySelector('canvas');

					if (isMobileViewport || hasCanvas || force) {
						fadeAndRemove(overlays);
						clearPoll();
						return;
					}

					if (pollId) return;
					pollStartedAt = Date.now();
					pollId = window.setInterval(() => {
						const ready = !!document.querySelector('canvas');
						const timedOut = Date.now() - pollStartedAt > MAX_WAIT_MS;
						if (ready || timedOut) {
							clearPoll();
							dismissFallback({ force: timedOut });
						}
					}, POLL_MS);
					maxWaitTimer = window.setTimeout(() => {
						clearPoll();
						dismissFallback({ force: true });
					}, MAX_WAIT_MS);
				};

				const scheduleForceCleanup = () => {
					if (forceCleanupTimer) window.clearTimeout(forceCleanupTimer);
					forceCleanupTimer = window.setTimeout(() => {
						dismissFallback({ force: true });
					}, FORCE_CLEANUP_MS);
				};

				const onRouteOrLoad = () => {
					onPageLoad();
					dismissFallback();
					// Sure-shot cleanup: remove any stale fallback if it somehow survives route churn.
					scheduleForceCleanup();
				};

				document.addEventListener('astro:page-load', onRouteOrLoad);
				document.addEventListener('astro:after-swap', onRouteOrLoad);
				window.addEventListener('load', onRouteOrLoad, { once: true });

				const observer = new MutationObserver(() => {
					dismissFallback();
				});
				if (document.body) {
					observer.observe(document.body, { childList: true, subtree: true });
				}

				window.__bgFallbackManager = {
					dismissFallback,
					dispose() {
						clearPoll();
						if (forceCleanupTimer) window.clearTimeout(forceCleanupTimer);
						observer.disconnect();
						document.removeEventListener('astro:page-load', onRouteOrLoad);
						document.removeEventListener('astro:after-swap', onRouteOrLoad);
					}
				};

				// Initial pass
				onRouteOrLoad();
			}
		</script>
	</body>
</html>

<style is:global>
		@import url('https://fonts.googleapis.com/css2?family=Audiowide&display=swap');
	@import url('https://fonts.googleapis.com/css2?family=Syncopate:wght@700&display=swap');
	@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap');

	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}

	html {
		/* font-family: system-ui, sans-serif; */
		background: #000000;
		background-size: 224px;
	}

	body {
		margin: 0;
		padding: 0;
		min-height: 100dvh;
		width: 100%;
	}

	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
</style>
