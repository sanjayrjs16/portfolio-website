---
interface WorkItem {
    type: 'featured' | 'project';
    title: string;
    description: string;
    image?: string;
    link?: string;
    github?: string;
    techStack?: string[];
    launchedBy?: string;
    awards?: string[];
    size?: 'large' | 'medium' | 'small';
}

interface Props {
    currentSection: keyof typeof sectionContent;
}

const { currentSection } = Astro.props;

// Placeholder content for each section
const sectionContent: Record<string, WorkItem[]> = {
    'notable-work': [
        {
            type: 'featured',
            title: 'Aadujeevitham: The Goat Life',
            description: 'Official movie website',
            image: 'https://thegoatlifefilm.com/_astro/every_breath_desktop.r_dlPKcE_Z16Fwf7.webp',
            link: '/works/goatlife',
            launchedBy: 'A R Rahman',
            size: 'large'
        },
        {
            type: 'project',
            title: 'OHC Network CoronaSafe Chatbot',
            description: 'Build a COVID-19 info chatbot for OHC Network that provided real-time updates & guidance aiding the efforts of Government of Kerala during the pandemic, operating on platforms like Facebook Messenger and Telegram.',
            github: 'https://github.com/ohcnetwork/bot',
            image: 'https://ohc.network/ohc_logo_white.svg',
            techStack: ['Python', 'Rasa framework', 'Docker', 'Github Actions', 'Heroku'],
            link: 'https://www.youtube.com/watch?v=A81YflXaZKQ',
            size: 'medium'
        },
        {
            type: 'project',
            title: 'Picturama-DeFi for Indie Cinema',
            description: 'Decentralized film funding platform built for <span class="highlight-text">Chainlink Fall 2021 Hackathon</span>. Enables direct audience participation in indie cinema financing using Ethereum smart contracts. Won a Filecoin pool prize from Protocol Labs for its use of IPFS storage.',
            github: 'https://github.com/picturama-defi',
            image: 'https://sanjayrjs.vercel.app/picturama.png',
            techStack: ['Next.js', 'Express.js', 'MongoDB', 'Solidity', 'IPFS',  'Web3.js', 'Chainlink', 'Filecoin'],
            link: 'https://www.youtube.com/watch?v=mnrl5tAp7eE&t=160s',
            awards: ['Chainlink Fall 2021 Hackathon – Filecoin Prize Winner'],
            size: 'small'
        }
    ],
    'personal-projects': [],
    'professional': [],
    'videos': []
} as const;
---

<div class="works-content">
    <div class="left-column">
        {sectionContent[currentSection]?.filter(item => item.type === 'featured' ).map(item => (
            <div class={item.size}>
               
                    <a href={item.link} class="project-card glass-card">
                        <div class="card-image">
                            <img src={item.image} alt={item.title} />
                        </div>
                        <div class="card-content">
                            <h2 class="title-text">{item.title}</h2>
                            <p class="description-text">
                                {item.description}
                                {item.launchedBy && 
                                    <span>
                                        Launched by <span class="highlight-text">{item.launchedBy}</span>
                                    </span>
                                }
                            </p>
                        </div>
                    </a>
              
            </div>
        ))}
    </div>
    
    <div class="right-column">
        {sectionContent[currentSection]?.filter(item => item.size === 'small' || item.size === 'medium').map(item => item.size === 'small' ? (
            <div class="small">
                <div class="project-card glass-card">
                    <div style="display: flex;  gap: 0.5rem; align-items: center; justify-content: flex-start;">
                    {item.image && (
                        <div class="project-image">
                            <img src={item.image} alt={item.title} />
                        </div>
                    )}
                   
                <p class="description-text">Decentralized film funding platform built for <span class="highlight-text">Chainlink Fall 2021 Hackathon</span>. Enables direct audience participation in indie cinema financing using Ethereum smart contracts. Won a Filecoin pool prize from <span class="highlight-text">Protocol Labs</span> for its use of IPFS storage.</p>
                </div>
                    <div class="card-header">
                        <h2 class="title-text">{item.title}</h2>
                    </div>
                    {item.awards && (
                        <div class="awards">
                            {item.awards.map(award => (
                                <span class="award-tag">🏆 {award}</span>
                            ))}
                        </div>
                    )}
                    <div class="card-links">
                        <a href={item.github} class="highlight-link" target="_blank" rel="noopener noreferrer">
                            <svg class="github-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                            </svg>
                            View Source
                        </a>
                        {item.link && (
                            <a href={item.link} class="highlight-link" target="_blank" rel="noopener noreferrer">
                                Watch Demo →
                            </a>
                        )}
                    </div>
                    {item.techStack && (
                        <div class="tech-stack">
                            {item.techStack.map(tech => <span class="tech-tag">{tech}</span>)}
                        </div>
                    )}
                </div>
            </div>
        ):( <div class="project-card glass-card">
                        <div style="display: flex;  gap: 0.5rem; align-items: center; justify-content: flex-start;">
                        {item.image && (
                            <div class="project-image">
                                <img src={item.image} alt={item.title} />
                            </div>
                        )}
                       <p class="description-text">Build a COVID-19 info chatbot for <span class="highlight-text">OHC Network</span> that provided real-time updates & guidance aiding the efforts of <span class="highlight-text">Government of Kerala</span> during the pandemic, operating on platforms like <span class="highlight-text">Facebook Messenger</span> and <span class="highlight-text">Telegram</span>.</p>
                       
                        </div>
                        <div class="card-header">
                            <h2 class="title-text">{item.title}</h2>
                            <span class="badge" >
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                                Open Source Contribution
                            </span>
                        </div>
                        {item.awards && (
                            <div class="awards" >
                                {item.awards.map(award => (
                                    <span class="award-tag">🏆 {award}</span>
                                ))}
                            </div>
                        )}
                        <div class="card-links">
                            <a href={item.github} class="highlight-link" target="_blank" rel="noopener noreferrer">
                                <svg class="github-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                                View Source
                            </a>
                            {item.link && (
                                <a href={item.link} class="highlight-link" target="_blank" rel="noopener noreferrer">
                                    Watch Demo →
                                </a>
                            )}
                        </div>
                        {item.techStack && (
                            <div class="tech-stack">
                                {item.techStack.map(tech => <span class="tech-tag">{tech}</span>)}
                            </div>
                        )}
                    </div>))}
    </div>
</div>

<style>
    .highlight-text {
		font-family: 'Space Grotesk', sans-serif;
		/* font-size: clamp(1rem, 1.2vw, 1.4rem); */
		color: #c42ae3;
		margin: 0.15rem 0;
		font-weight: 600;
		text-wrap: nowrap;
	}
    .works-content {
        display: flex;
        gap: 1rem;
        /* display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        padding: 1rem; */
        /* height: calc(100vh - 80px); */
        /* max-width: 1600px; */
        margin: 0 auto;
        /* overflow-y: auto; */
    }

    .left-column, .right-column {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .large {
        min-height: 10vmin;
    }

    .medium {
        min-height: 220px;
        max-width: 35vw;
    }

    .small {
        min-height: 180px;
    }

    .project-image {
        height: 100px;
        min-width: 100px;
        padding: 0.75rem 0.75rem 0.25rem;
    }

    .project-image img {
        max-height: 100%;
        width: auto;
        object-fit: contain;
    }

    .featured-card, .project-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 
            0 4px 30px rgba(0, 0, 0, 0.1),
            inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    }

    .featured-card {
        width: 10vmin;
        text-decoration: none;
        color: white;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .featured-card:hover, .project-card:hover {
        background: rgba(255, 255, 255, 0.08);
        transform: translateY(-5px);
        box-shadow: 
            0 8px 40px rgba(0, 0, 0, 0.2),
            inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .featured-card:hover .card-image img {
        transform: scale(1.05);
    }

    .card-content {
        padding: 0.2rem;
    }

    .project-card {
        padding: 0.75rem;
        color: white;
    }

    .card-header {
        margin-bottom: 0.5rem;
    }

    .card-header .title-text {
        font-size: clamp(1rem, 1.5vw, 1.3rem);
        text-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        text-align: left;
        text-transform:uppercase;
        line-height: 2.2;
        margin: 0;
    }

    .card-links {
        margin: 0.5rem 0;
        display: flex;
        gap: 0.5rem;
    }

    .card-links .highlight-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .github-icon {
        opacity: 0.8;
        transition: opacity 0.3s ease;
    }

    .highlight-link:hover .github-icon {
        opacity: 1;
    }

    .tech-stack {
        padding-top: 0.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
    }

    .tech-tag {
        background: rgba(138, 43, 226, 0.1);
        color: rgba(255, 255, 255, 0.9);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-size: 0.8rem;
        border: 1px solid rgba(138, 43, 226, 0.2);
    }

    .awards {
        margin: 0.5rem 0;
        gap: 0.25rem;
    }

    .award-tag {
        background: rgba(255, 215, 0, 0.1);
        color: rgba(255, 215, 0, 0.9);
        padding: 0.3rem 0.8rem;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        border: 1px solid rgba(255, 215, 0, 0.2);
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(46, 204, 113, 0.1);
        color: rgba(46, 204, 113, 0.9);
        padding: 0.3rem 0.8rem;
        border-radius: 4px;
        font-size: 0.85rem;
        border: 1px solid rgba(46, 204, 113, 0.2);
        margin-bottom: 1rem;
    }

    .description-text {
        margin: 0.25rem 0;
        font-size: 0.9rem;
        line-height: 1.3;
    }

    @media (max-width: 1200px) {
        .works-content {
            grid-template-columns: 1fr 1fr;
        }

        .large {
            min-height: 20vmin;
        }
    }

    @media (max-width: 768px) {
        .works-content {
            flex-direction: column;
            height: auto;
            padding: 0.75rem;
        }

        .large {
            min-height: 20vmin;
        }

        .medium {
            min-height: 180px;
            max-width: none;
        }

        .small {
            min-height: 160px;
        }
    }
</style> 