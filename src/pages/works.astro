---
import StarryLayout from '../layouts/StarryLayout.astro';
import WorksMenu from '../components/Works/WorksMenu.astro';
import WorksContent from '../components/Works/WorksContent.astro';
     
// SEO metadata
const title = "Works - Sanjay Rajesh";
const description = "Portfolio of works and projects by Sanjay Rajesh - Including The Goat Life official website, personal projects, and professional experience.";

// Current section (can be passed via props or URL params later)
const currentSection = "notable-work";
---

<StarryLayout title={title} description={description}>
    <div class="works-container">
        <!-- Mobile Menu Button -->
        <button class="mobile-menu-btn" aria-label="Toggle menu">
            <span class="menu-icon"></span>
        </button>

        <!-- Left Menu -->
        <WorksMenu currentSection={currentSection} />

        <!-- Content Area -->
        <main class="content-area">
            <!-- <nav class="breadcrumb" aria-label="breadcrumb">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li>Works</li>
                </ol>
            </nav> -->
            <WorksContent currentSection={currentSection} />
        </main>
    </div>
</StarryLayout>

<style>
    .works-container {
        display: flex;
        min-height: 100vh;
        padding-top: 4rem;
        position: relative;
    }

    .mobile-menu-btn {
        position: fixed;
        left: 1rem;
        bottom: 2rem;
        z-index: 100;
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        cursor: pointer;
        transition: all 0.3s ease;
        display: block; /* Show on all screen sizes */
    }

    .menu-icon {
        position: relative;
        display: block;
        width: 1.5rem;
        height: 2px;
        background: white;
        margin: 0 auto;
        transition: all 0.3s ease;
    }

    .menu-icon::before,
    .menu-icon::after {
        content: '';
        position: absolute;
        width: 1.5rem;
        height: 2px;
        background: white;
        transition: all 0.3s ease;
    }

    .menu-icon::before {
        transform: translateY(-6px);
    }

    .menu-icon::after {
        transform: translateY(6px);
    }

    .content-area {
        flex: 1;
        padding: 2rem;
        margin-left: 0; /* Remove the permanent margin */
    }

    .breadcrumb {
        margin-bottom: 2rem;
    }

    .breadcrumb ol {
        list-style: none;
        padding: 0;
        display: flex;
        gap: 0.5rem;
        color: rgba(255, 255, 255, 0.7);
        font-family: 'Space Grotesk', sans-serif;
    }

    .breadcrumb li:not(:last-child)::after {
        content: '>';
        margin-left: 0.5rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .breadcrumb a {
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .breadcrumb a:hover {
        color: white;
    }

    /* Menu open state styles */
    .works-container.menu-open .mobile-menu-btn .menu-icon {
        background: transparent;
    }

    .works-container.menu-open .mobile-menu-btn .menu-icon::before {
        transform: rotate(45deg);
    }

    .works-container.menu-open .mobile-menu-btn .menu-icon::after {
        transform: rotate(-45deg);
    }

    @media (max-width: 768px) {
        .content-area {
            padding: 1rem;
        }
    }
</style>

<script>
    // Mobile menu functionality
    const menuBtn = document.querySelector('.mobile-menu-btn');
    const container = document.querySelector('.works-container');
    const menu = document.querySelector('.works-menu');

    menuBtn?.addEventListener('click', () => {
        container?.classList.toggle('menu-open');
        menu?.classList.toggle('open');
    });
</script>