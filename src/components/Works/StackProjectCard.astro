---
import type { StackProject } from './workProjectTypes';

interface Props {
    project: StackProject;
}

const { project } = Astro.props;
const stackList = project.stack ?? [];
---

<article
    class:list={['stack-card', { 'stack-card--has-study': project.caseStudyPath }]}
    data-slug={project.slug}
>
    {
        project.caseStudyPath && (
            <a class="stack-card__hit" href={project.caseStudyPath}>
                <span class="sr-only">View case study: {project.title}</span>
            </a>
        )
    }
    <div class="stack-card__visual">
        <img
            src={project.image}
            alt=""
            width={120}
            height={120}
            loading="lazy"
            decoding="async"
            fetchpriority="low"
        />
    </div>
    <div class="stack-card__body">
        {
            project.badge && (
                <div class="stack-card__tags">
                    <span class="tag tag--accent">{project.badge}</span>
                </div>
            )
        }
        <h3 class="stack-card__title">{project.title}</h3>
        <p class="stack-card__summary">{project.summary}</p>
        {
            stackList.length > 0 && (
                <p class="stack-card__stack">
                    {stackList.map((tech) => (
                        <span class="stack-pill">{tech}</span>
                    ))}
                </p>
            )
        }
        <div class="stack-card__links">
            {project.links.map((link) => (
                <a class="work-link work-link--light" href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.label}
                </a>
            ))}
        </div>
    </div>
    {
        project.caseStudyPath && (
            <span class="card-open-icon" aria-hidden="true" title="Open case study">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
            </span>
        )
    }
</article>

<style>
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .stack-card {
        position: relative;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 0.85rem;
        align-items: start;
        min-width: 0;
        width: 100%;
        max-width: 100%;
        padding: 0.95rem 1rem;
        padding-right: 2.5rem;
        background: linear-gradient(168deg, rgba(252, 250, 246, 0.96), rgba(236, 232, 226, 0.93));
        border: 1px solid rgba(200, 188, 170, 0.48);
        border-radius: 14px;
        backdrop-filter: blur(16px);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.06),
            0 4px 22px rgba(20, 12, 40, 0.09),
            inset 0 1px 0 rgba(255, 255, 255, 0.65);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            border-color 0.25s ease;
    }

    .stack-card--has-study:hover {
        transform: translateY(-2px);
        border-color: rgba(180, 160, 130, 0.52);
        box-shadow:
            0 0 0 1px rgba(124, 58, 237, 0.1),
            0 10px 32px rgba(20, 12, 40, 0.12);
    }

    .stack-card--has-study:hover .card-open-icon {
        color: #6d28d9;
        border-color: rgba(124, 58, 237, 0.35);
    }

    .stack-card__hit {
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: inherit;
    }

    .stack-card__hit:focus-visible {
        outline: 2px solid rgba(124, 58, 237, 0.65);
        outline-offset: 2px;
    }

    .card-open-icon {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        z-index: 3;
        pointer-events: none;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.32rem;
        border-radius: 10px;
        color: rgba(68, 58, 48, 0.55);
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(190, 178, 160, 0.45);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    }

    .stack-card__visual {
        position: relative;
        z-index: 0;
        flex-shrink: 0;
        width: 4.25rem;
        height: 4.25rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.75);
        border: 1px solid rgba(200, 188, 170, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .stack-card__visual img {
        max-width: 85%;
        max-height: 85%;
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
    }

    .stack-card__body {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        font-family: 'Space Grotesk', sans-serif;
        position: relative;
        z-index: 2;
        pointer-events: none;
    }

    .stack-card__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .tag {
        font-size: 0.6rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.18rem 0.45rem;
        border-radius: 999px;
        border: 1px solid rgba(140, 130, 118, 0.35);
        color: rgba(68, 60, 52, 0.75);
        background: rgba(255, 255, 255, 0.5);
    }

    .tag--accent {
        border-color: rgba(124, 58, 237, 0.28);
        color: rgba(91, 33, 182, 0.9);
        background: rgba(139, 92, 246, 0.08);
    }

    .stack-card__title {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: clamp(0.84rem, 2vw, 0.98rem);
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: #1c1917;
    }

    .stack-card__summary {
        margin: 0;
        font-size: 0.8rem;
        line-height: 1.45;
        color: rgba(55, 48, 40, 0.85);
        overflow-wrap: anywhere;
    }

    .stack-card__stack {
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
    }

    .stack-pill {
        font-size: 0.6rem;
        font-weight: 500;
        padding: 0.14rem 0.38rem;
        border-radius: 6px;
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(124, 58, 237, 0.22);
        color: rgba(76, 29, 149, 0.9);
    }

    .stack-card__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 0.55rem;
        margin-top: 0.2rem;
    }

    .work-link--light {
        color: #6d28d9;
        text-decoration: none;
        position: relative;
        font-weight: 600;
        font-size: 0.82rem;
        font-family: 'Space Grotesk', sans-serif;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        border-bottom: 1px solid rgba(202, 138, 4, 0.55);
        padding-bottom: 1px;
        pointer-events: auto;
    }

    .work-link--light:hover {
        color: #5b21b6;
        border-bottom-color: rgba(202, 138, 4, 0.85);
    }

    @media (max-width: 520px) {
        .stack-card {
            grid-template-columns: 1fr;
            padding: 0.8rem 0.85rem;
            padding-right: 2.35rem;
        }

        .stack-card__visual {
            width: 3.5rem;
            height: 3.5rem;
        }
    }
</style>
