---
import StarryLayout from '../layouts/StarryLayout.astro';
import WorksMenu from '../components/Works/WorksMenu.astro';
import WorksContent from '../components/Works/WorksContent.astro';
// SEO metadata
const title = "Works - Sanjay Rajesh";
const description = "Portfolio of works and projects by Sanjay Rajesh - Including The Goat Life official website, personal projects, and professional experience.";

// Current section (can be passed via props or URL params later)
const currentSection = "notable-work";
---

<StarryLayout title={title} description={description}>
    <div class="works-container">
        <!-- Mobile Menu Button -->
        <!-- <button class="mobile-menu-btn" aria-label="Toggle menu">
            <span class="menu-icon"></span>
        </button> -->

        <!-- Left Menu -->
        <!-- <WorksMenu currentSection={currentSection} /> -->

        <!-- Content Area -->
        <main class="content-area">
            <section class="notable-work">
                <h2 class="section-title">Notable Work</h2>
                <div class="cards-grid">
                    <WorksContent currentSection={currentSection} />
                </div>
            </section>

            <section class="professional-experience">
                <h2 class="section-title">Professional Journey</h2>
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <div class="timeline-header">
                                <h3>Senior Software Engineer</h3>
                                <span class="company">Fingent Global Solutions</span>
                                <span class="duration">2022 - Present</span>
                            </div>
                            <p>
                                Leading frontend engineering for <span class="highlight-text">CBN Superbook</span>, a multilingual, gamified Bible-learning platform with over <span class="highlight-text">39 million+ global users</span>. 
                                <span class="highlight-text">Superbook</span> is an animated series originally launched in the <span class="highlight-text">1980s</span> and revived in the <span class="highlight-text">2010s</span> by the <span class="highlight-text">Christian Broadcasting Network (CBN)</span> — one of the world’s largest Christian media organizations. 
                                The platform, based on this legacy series, is now a full-fledged <span class="highlight-text">digital ecosystem</span> available on web and mobile (<span class="highlight-text">Android & iOS</span>), offering <span class="highlight-text">interactive Bible episodes</span>, <span class="highlight-text">quests</span>, <span class="highlight-text">games</span>, and <span class="highlight-text">child-safe community features</span>.
                              </p>
                                 <!-- <br/><br/> -->
                                 
                            <div class="tech-stack-icons">
                                <span class="tech-tag">React</span>
                                <span class="tech-tag">GraphQL</span>
                                <span class="tech-tag">Apollo Client</span>
                                <span class="tech-tag">WunderGraph</span>
                                <span class="tech-tag">Drupal 9</span>
                                <span class="tech-tag">Tailwind CSS</span>
                                <span class="tech-tag">Azure</span>
                                <span class="tech-tag">i18n</span>
                                <span class="tech-tag">Bitbucket</span>
                                <span class="tech-tag">Pantheon</span>
                                <span class="tech-tag">Jira</span>
                                <span class="tech-tag">Figma</span>
                            </div>
                             </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <div class="timeline-header">
                                <h3>Software Engineer</h3>
                                <span class="company">Engati Technologies</span>
                                <span class="duration">2021 - 2022</span>
                            </div>
                            <p>
                                Engati is a batteries included no-code drag and drop based chatbot creation and CX platform, simplifying CX managment,  cross channel deployments etc. Contributed to Engati’s core platform by shipping features like  <span class="highlight-text">Bot store </span> , migrated legacy code to Next.js for improved performance and SEO, and worked cross-functionally with product and marketing teams. </p>
                                <div class="tech-stack-icons">
                                    <span class="tech-tag">React</span>
                                    <span class="tech-tag">TypeScript</span>
                                    <span class="tech-tag">Next.js</span>
                                    <span class="tech-tag">Python Flask</span>
                                    <span class="tech-tag">React Native</span>
                                    <span class="tech-tag">Angular</span>
                                    <span class="tech-tag">BaseWeb UI</span>
                                    <span class="tech-tag">Jenkins</span>
                                    <span class="tech-tag">Gitlab</span>
                                    <span class="tech-tag">Jira</span>
                                    <span class="tech-tag">Figma</span>
                                </div>
                            </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <div class="timeline-header">
                                <h3>Assistant Systems Engineer</h3>
                                <span class="company">Tata Consultancy Services</span>
                                <span class="duration">2019 - 2021</span>
                            </div>
                            <p>
                                Built and integrated a GA Mapping self-service portal for <span class="highlight-text">Aon Plc</span>, reducing monthly support tickets by 25% and earning a customer appreciation award. Developed a BDD test framework with <span class="highlight-text">Jenkins CI/CD</span>, contributed to internal tools for <span class="highlight-text">US Bank Corp</span>, and created a chatbot PoC using <span class="highlight-text">RiveScript, React</span>, and <span class="highlight-text">Node.js</span> to replace outdated PDF guides.
                              </p>
                              <div class="tech-stack-icons">
                                <span class="tech-tag">Java J2EE</span>
                                <span class="tech-tag">Oracle MySQL</span>
                                <span class="tech-tag">JSP</span>
                                <span class="tech-tag">Node.js</span>
                                <span class="tech-tag">React</span>
                                <span class="tech-tag">Cucumber BDD</span>
                                <span class="tech-tag">Jquery</span>
                            </div>
                            </div>
                    </div>
                </div>
            </section>
        </main>
    </div>
</StarryLayout>

<style>
    .works-container {
        display: flex;
        padding-top: 4rem;
        position: relative;
    }

    .mobile-menu-btn {
        position: fixed;
        left: 1rem;
        bottom: 2rem;
        z-index: 100;
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        cursor: pointer;
        transition: all 0.3s ease;
        display: block;
    }

    .menu-icon {
        position: relative;
        display: block;
        width: 1.5rem;
        height: 2px;
        background: white;
        margin: 0 auto;
        transition: all 0.3s ease;
    }

    .menu-icon::before,
    .menu-icon::after {
        content: '';
        position: absolute;
        width: 1.5rem;
        height: 2px;
        background: white;
        transition: all 0.3s ease;
    }

    .menu-icon::before {
        transform: translateY(-6px);
    }

    .menu-icon::after {
        transform: translateY(6px);
    }

    .content-area {
        flex: 1;
        padding: 2rem;
        margin-left: 0;
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .section-title {
        font-family: 'Audiowide', sans-serif;
        text-transform: uppercase;
        font-size: 2rem;
        color: white;
        margin-bottom: 2rem;
        margin-left: 1rem;
        position: relative;
        display: inline-block;
        animation: fadeIn 0.5s ease-out forwards;
        animation-delay: calc(var(--index) * 0.1s);
        animation-fill-mode: forwards;
    }

    .section-title::after {
        content: '';
        position: absolute;
        bottom: -0.5rem;
        left: 0;
        width: 60px;
        height: 2px;
        background: rgba(255, 255, 255, 0.3);
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
    }

    /* Timeline Styles */
    .timeline {
        position: relative;
        padding: 2rem 0;
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: rgba(255, 255, 255, 0.1);
    }

    .timeline-item {
        position: relative;
        padding-left: 2rem;
        margin-bottom: 3rem;
        font-family: 'Space Grotesk', sans-serif;
    }

    .timeline-dot {
        position: absolute;
        left: -4px;
        top: 0;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: white;
        box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.1);
    }

    .timeline-content {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        padding: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .timeline-header {
        margin-bottom: 1rem;
    }

    .timeline-header h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.25rem;
        color: white;
        margin: 0 0 0.5rem 0;
    }

    .company {
        display: inline-block;
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.8);
        margin-right: 1rem;
    }
    .tech-stack-icons {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.tech-tag {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
}

    .duration {
        display: inline-block;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.6);
    }

    .timeline-content p {
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.6;
        margin: 0;
    }

    /* Menu open state styles */
    .works-container.menu-open .mobile-menu-btn .menu-icon {
        background: transparent;
    }

    .works-container.menu-open .mobile-menu-btn .menu-icon::before {
        transform: rotate(45deg);
    }

    .works-container.menu-open .mobile-menu-btn .menu-icon::after {
        transform: rotate(-45deg);
    }

    @media (max-width: 768px) {
        .content-area {
            padding: 1rem;
            gap: 3rem;
        }

        .section-title {
            font-size: 1.75rem;
        }

        .cards-grid {
            grid-template-columns: 1fr;
        }

        .timeline-content {
            padding: 1.25rem;
        }

        .timeline-header h3 {
            font-size: 1.1rem;
        }

        .company, .duration {
            display: block;
            margin-bottom: 0.25rem;
        }
    }
    
</style>

<script>
    // Mobile menu functionality
    const menuBtn = document.querySelector('.mobile-menu-btn');
    const container = document.querySelector('.works-container');
    const menu = document.querySelector('.works-menu');

    menuBtn?.addEventListener('click', () => {
        container?.classList.toggle('menu-open');
        menu?.classList.toggle('open');
    });
</script>